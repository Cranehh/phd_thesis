  booktitle = {Unifying {{Themes}} in {{Complex Systems}}},
  author = {Sadek, Add and Basha, Nagi},
  editor = {Minai, Ali and Braha, Dan and {Bar-Yam}, Yaneer},
  year = 2008,
  pages = {503--510},
