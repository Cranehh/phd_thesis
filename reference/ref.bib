@article{chenPathVelocityPlanning2019,
  title = {A Path and Velocity Planning Method for Lane Changing Collision Avoidance of Intelligent Vehicle Based on Cubic 3-{{D Bezier}} Curve},
  author = {Chen, Long and Qin, Dongfang and Xu, Xing and Cai, Yingfeng and Xie, Ju},
