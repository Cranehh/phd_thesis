@article{chenDoesIntercityCommuting2025,
  title = {Does Inter-City Commuting Lead to Increasing Disparity of Public Service Accessibility within {{Chinese}} Metropolitan Areas? {{A}} Case Study of {{Guangzhou}}},
  shorttitle = {Does Inter-City Commuting Lead to Increasing Disparity of Public Service Accessibility within {{Chinese}} Metropolitan Areas?},
  author = {Chen, Zifeng},
