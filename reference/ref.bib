@article{creazzaEvaluatingLogisticsNetwork2010,
  title = {Evaluating Logistics Network Configurations for a Global Supply Chain},
  author = {Creazza, A. and Dallari, F. and Melacini, M.},
  year = 2010,
  month = mar,
  journal = {Supply Chain Management: An International Journal},
  volume = {15},
  number = {2},
  pages = {154--164},
  issn = {1359-8546},
  doi = {10.1108/13598541011028750},
  urldate = {2026-01-19},
  abstract = {This paper aims to identify and assess different configurations to design logistics networks in global sourcing contexts. A framework to support the choice of the most suitable logistics network is developed.Starting from an overview of previous research on global sourcing and global logistics network design, followed by a series of interviews with international freight forwarders and logistics providers, five main logistics network configurations are identified and the paper proposes a framework to evaluate their cost-effectiveness, deriving the overall logistics cost by means of simulation.On the basis of the analysis of different scenarios the paper develops a taxonomy for selecting the most suitable logistics network configuration, with respect to some key logistics factors and purchasing strategies.The analysis has been focused on ocean container shipping, the primary transportation mode for world trade.In a context characterised by the widespread adoption of direct shipment with full container load (FCL) ocean shipping (with implications on inventory levels), the provided taxonomy can represent a useful tool to support companies in choosing the most suitable combination of configurations for setting their global logistics network.The impact of globalisation on logistics network configuration has received little attention from supply chain researchers to date. The originality of the present paper is twofold. First, a framework to assess the overall logistics costs is developed. Second, the paper presents an original taxonomy for the selection of the most suitable logistics network.},
  keywords = {/unread},
  file = {/Users/haohe/Zotero/storage/KHGDGCAT/Creazza 等 - 2010 - Evaluating logistics network configurations for a global supply chain.pdf;/Users/haohe/Zotero/storage/WT42JYQ6/13598541011028750.html}
