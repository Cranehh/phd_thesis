@phdthesis{WangYanBinTaiYangNengGuangFuFaDianXiangMuTouZiFengXianGuanLiYanJiu2014,
  type = {{硕士}},
  title = {{太阳能光伏发电项目投资风险管理研究}},
  author = {{王燕斌}},
  year = 2014,
  abstract = {随着传统化石能源逐渐匮乏价格高企,以及人类对环境保护问题愈发关注,可再生能源以其无污染、建设周期短、投资灵活、资源丰富等特点逐渐得到了人们的重视。在政策的鼓励下,我国的太阳能光伏发电项目飞速发展,但由于一些不确定性因素的存在,使得现阶段依旧不可规避多种风险,如果不及时控制和防范将会对太阳能光伏发电项目的健康发展起到制约作用,因此构建一套适合我国太阳能光伏发电项目的投资风险管理体系显得尤为重要。本文正是在此背景下展开的研究工作。目前,可再生能源项目投资风险管理方面的探索主要集中在对评价方法的改进性研究。本研究结合目前该学科的相关理论,以太阳能光伏发电项目为基础,进行探讨,针对在项目投资阶段,引入太阳能光伏发电项目的投资风险管理方法,对太阳能发电项目进行投资风险识别并建立投资风险因素清单,结合基于多层次模糊综合评价法对太阳能发电项目风险进行分析,建立相关结构模型,构建太阳能发电项目投资风险评价系统,同时根据实际的太阳能光伏发电项目进行研究,并基于研究结果制定了太阳能发电项目的投资风险控制和防范方案。作者完成的主要工作如下：(1)采用检查表法和头脑风暴法对太阳能光伏发电项目的投资风险进行识别并建立风险因素清单；(2)结合太阳能光伏发电项目特点运用多层次模糊综合评价法建立太阳能发电项目投资风险评价模型；(3)结合实际工作真对作者提出的基于多层次模糊综合评价法对太阳能发电项目投资风险进行应用。近几年来,太阳能发电产业在节能减排、生态文明建设等方面的巨大贡献已得到广泛认可并已作为国家战略性新兴产业之一推动发展,通过本文对太阳能光伏发电项目风险管理的研究并结合实际案例加以应用,可以对这一新兴产业以及可再生能源发电项目的投资决策阶段风险管理提供支持和参考。},
  collaborator = {{张鹏举} and {隋杰}},
  langid = {chinese},
  school = {中国科学院大学（工程管理与信息技术学院）},
  keywords = {,/unread,Investment,Project Management,Risk Management,Solar Photovoltaic},
