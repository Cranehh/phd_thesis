  issn = {13619209},
  doi = {10.1016/j.trd.2022.103340},
  abstract = {To assess the impact of any proposed development, it is necessary to estimate the trips that are likely to be generated because of such development. In case of developing countries, land use pattern varies significantly and it becomes very challenging to model the trip rates. In view of this, an effort has been made to synthesize the available literature related to modelling of trip generation rates. This paper provides a comprehensive review of studies related to impact of land use on trip rates, data collection techniques and modelling approaches. Major challenges associated with modelling of trip generation includes the unavailability of standard reference databases for multimodal trip generation, consideration of land use evolvement, less explored machine learning modelling approaches, and the feasibility of using emerging data collection techniques in travel surveys. Finally, a framework is proposed for modelling multimodal trip generation rates considering the above identified issues.},
