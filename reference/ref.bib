}

@article{geMultiAgentTransferReinforcement2022,
  title = {Multi-{{Agent Transfer Reinforcement Learning With Multi-View Encoder}} for {{Adaptive Traffic Signal Control}}},
  author = {Ge, Hongwei and Gao, Dongwan and Sun, Liang and Hou, Yaqing and Yu, Chao and Wang, Yuxin and Tan, Guozhen},
