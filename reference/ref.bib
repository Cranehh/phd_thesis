}

@article{yuTransitioningIncentivebasedUser2025,
  title = {Transitioning from Incentive-Based User Acquisition to Loyal Retention on the Mobility-as-a-Service Platform: {{A}} Large-Scale Social Experiment},
  shorttitle = {Transitioning from Incentive-Based User Acquisition to Loyal Retention on the Mobility-as-a-Service Platform},
  author = {Yu, Chengcheng and Dong, Wentao and Ye, Nixuan and Yuan, Quan and Yang, Chao},
  year = 2025,
