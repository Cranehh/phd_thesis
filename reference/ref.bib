}

@article{wattsDynamicDeepReinforcement2022,
  title = {A {{Dynamic Deep Reinforcement Learning-Bayesian Framework}} for {{Anomaly Detection}}},
  author = {Watts, Jeremy and {van Wyk}, Franco and Rezaei, Shahrbanoo and Wang, Yiyang and Masoud, Neda and Khojandi, Anahita},
  year = 2022,
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  volume = {23},
  number = {12},
  pages = {22884--22894},
  publisher = {IEEE},
  issn = {15580016},
  doi = {10.1109/TITS.2022.3200906},
  abstract = {To assure the successful operation of connected and automated vehicles, it is critical to detect and isolate anomalous and/or faulty information in a timely manner. To do so, anomaly detection techniques should be implemented in real-time where if the probability of anomalous information exceeds a certain threshold, the information is dealt with accordingly. Traditionally, the threshold for judging whether the data is anomalous is fixed and determined {$<$}italic{$>$}a priori{$<$}/italic{$>$}. However, not only does this approach fail to account for the feedback obtained during a trip on the performance of the algorithms, but it also fails to respond to potential changes in rates of anomalies. Hence, it is important to develop an approach that can dynamically alter this threshold in response to exogenous factors to assure reliable and robust system operation. We develop a mathematical framework which utilizes a dynamic threshold for an anomaly classification algorithm in order to maximize the safety of a trip. Specifically, we develop and pair an anomaly classification algorithm based on convolutional neural networks (CNN), with a partially observable Markov decision process (POMDP) model. We solve the resulting POMDP model using the asynchronous advantage actor critic (A3C) deep reinforcement learning algorithm. The prescribed policy determines the anomaly classification threshold in real-time that maximizes the performance. Our numerical experiments show that the POMDP model outperforms state-of-the-art benchmarks, especially under more difficult to detect anomaly profiles.},
  keywords = {anomaly detection,Anomaly detection,Bayes methods,connected and automated vehicles,Convolutional neural networks,Cyber-physical systems,Data models,deep reinforcement learning,dynamic model,Heuristic algorithms,Numerical models,partial information,Vehicle dynamics,vehicle safety},
  annotation = {TLDR: A mathematical framework which utilizes a dynamic threshold for an anomaly classification algorithm in real-time in order to maximize the safety of a trip and shows that the POMDP model outperforms state-of-the-art benchmarks, especially under more difficult to detect anomaly profiles.},
  file = {/Users/haohe/Zotero/storage/YXDBF7Q2/A_Dynamic_Deep_Reinforcement_Learning-Bayesian_Framework_for_Anomaly_Detection.pdf}
}

