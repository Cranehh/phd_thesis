  urldate = {2025-08-22},
  abstract = {An important part of any model of vehicle crashes is the development of a procedure to estimate crash injury severity. After reviewing existing models of crash severity, this paper outlines the development of a modelling approach aimed at measuring the injury severity of people in two-vehicle road crashes. This model can be incorporated into a discrete event traffic simulation model, using simulation model outputs as its input. The model can then serve as an integral part of a simulation model estimating the crash potential of components of the traffic system. The model is developed using Newtonian Mechanics and Generalised Linear Regression. The factors contributing to the speed change ({$\Delta$}Vs) of a subject vehicle are identified using the law of conservation of momentum. A Log-Gamma regression model is fitted to measure speed change ({$\Delta$}Vs) of the subject vehicle based on the identified crash characteristics. The kinetic energy applied to the subject vehicle is calculated by the model, which in turn uses a Log-Gamma Regression Model to estimate the Injury Severity Score of the crash from the calculated kinetic energy, crash impact type, presence of airbag and/or seat belt and occupant age.},
  langid = {american},
  keywords = {Conservation of momentum,Crash severity,Generalised linear regression model,Injury Severity Score,Kinetic energy},
  annotation = {TLDR: This paper outlines the development of a modelling approach aimed at measuring the injury severity of people in two-vehicle road crashes, developed using Newtonian Mechanics and Generalised Linear Regression.},
