  langid = {english},
  keywords = {Economics,History},
  file = {/Users/haohe/Zotero/storage/UWSBH7WQ/Alfani 和 Carballo - 2023 - Income and inequality in the Aztec Empire on the e.pdf}
}

@article{aliGameTheorybasedApproach2019,
  title = {A Game Theory-Based Approach for Modelling Mandatory Lane-Changing Behaviour in a Connected Environment},
  author = {Ali, Yasir and Zheng, Zuduo and Haque, Md. Mazharul and Wang, Meng},
