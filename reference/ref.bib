@article{chuTrafficSignalControl2022,
  title = {Traffic {{Signal Control Using End-to-End Off-Policy Deep Reinforcement Learning}}},
  author = {Chu, Kai Fung and Lam, Albert Y.S. and Li, Victor O.K.},
  year = 2022,
