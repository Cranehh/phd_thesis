@article{LiangWeiJiYuJuBuLianTongXingDeZaiTuDongTaiLuJingYouDaoFangFa2018,
  title = {{基于局部连通性的在途动态路径诱导方法}},
  author = {{梁伟} and {张毅} and {胡坚明}},
  year = 2018,
