@article{sunUnderstandingUrbanMobility2016,
  title = {Understanding Urban Mobility Patterns with a Probabilistic Tensor Factorization Framework},
  author = {Sun, Lijun and Axhausen, Kay W.},
  year = 2016,
  month = sep,
  journal = {Transportation Research Part B: Methodological},
  volume = {91},
  pages = {511--524},
  issn = {0191-2615},
  doi = {10.1016/j.trb.2016.06.011},
  urldate = {2026-07-30},
  abstract = {The rapid developments of ubiquitous mobile computing provide planners and researchers with new opportunities to understand and build smart cities by mining the massive spatial-temporal mobility data. However, given the increasing complexity and volume of the emerging mobility datasets, it also becomes challenging to build novel analytical framework that is capable of understanding the structural properties and critical features. In this paper, we introduce an analytical framework to deal with high-dimensional human mobility data. To this end, we formulate mobility data in a probabilistic setting and consider each record a multivariate observation sampled from an underlying distribution. In order to characterize this distribution, we use a multi-way probabilistic factorization model based on the concept of tensor decomposition and probabilistic latent semantic analysis (PLSA). The model provides us with a flexible approach to understand multi-way mobility involving higher-order interactions---which are difficult to characterize with conventional approaches---using simple latent structures. The model can be efficiently estimated using the expectation maximization (EM) algorithm. As a numerical example, this model is applied on a four-way dataset recording 14 million public transport journeys extracted from smart card transactions in Singapore. This framework can shed light on the modeling of urban structure by understanding mobility flows in both spatial and temporal dimensions.},
  keywords = {/unread,Data-driven,Human mobility,Smart card data,Tensor decomposition,Urban computing},
  file = {/Users/haohe/Zotero/storage/B8EPVCRD/Sun和Axhausen - 2016 - Understanding urban mobility patterns with a probabilistic tensor factorization framework.pdf;/Users/haohe/Zotero/storage/SPT5K3SW/S0191261516300261.html}
}

@phdthesis{SunZhiYingKaoLuHuoDongDeDianDongQiCheChongFangDianXuQiuYuCeYuDingJieJiZhiYanJiu2024,
  type = {{硕士学位论文}},
  title = {{考虑活动的电动汽车充放电需求预测与定价机制研究}},
  author = {{孙志颖}},
  year = 2024,
  doi = {10.27248/d.cnki.gnjqc.2024.001569},
  urldate = {2025-05-28},
  abstract = {能源危机、``双碳''政策等多因素共同助力新能源汽车行业的发展,电动汽车(Electric Vehicle,EV)作为新能源汽车的中坚力量已进入快速发展的阶段。对电动汽车的研究贯穿``能源-经济-环境''三个维度,大规模电动汽车入网对城市电网运行构成威胁。准确的预测电动汽车入网负荷需求是研究电力交通网络耦合的前提,对电动汽车充放电行为的深度剖析是电力交通耦合网络协调可持续发展的重要保障。因此,本文基于活动-出行链理论,围绕电动汽车入网影响分析、充放电离散选择以及电动汽车聚合商(Electric Vehicle Aggregator,EVA)展开研究。本文主要内容与创新点如下:(1)首先,针对传统历史数据预测和概率选择方法滞后性较大的问题,本文引入活动-出行链模型分析电动汽车用户的活动-出行行为特性,从用户需求侧出发预测电动汽车的充电负荷需求时空分布。建构电动汽车入网影响力评估体系,分析不同情境下充电负荷对电网的影响。仿真结果表明考虑用户活动-出行的充电负荷预测更符合区域的用电性质,大规模电动汽车无序入网增大了电网的运行风险,降低了电网的运行效益。(2)其次,传统电动汽车充放电决策多以行驶过程中的荷电状态作为决策变量,缺乏对用户侧的考虑,为进一步探究电动汽车用户的充放电行为特性,本文基于活动-出行链模型建立电动汽车用户充放电行为选择模型,设置多种仿真情境进行电价灵敏度分析。仿真结果表明,电动汽车用户的充放电行为由成本、损耗和心理偏好共同决定,且充放电价影响电动汽车用户的充放电决策,从而影响电网各个负荷状态下的运行指标。(3)最后,针对电动汽车用户无序入网对电网运行的威胁,考虑电价、用户与电网之间的关联性,本文建立电动汽车聚合商作为电网和用户之间的桥梁。以电动汽车聚合商收益最大和电动汽车用户成本最低为目标函数建立主从博弈模型,电动汽车聚合商通过充放电价引导电动汽车用户优化充放电决策。选用量子粒子群算法(Quantum Particle Swarm Optimization,QPSO)求解博弈的均衡解。仿真结果表明,在聚合商与用户博弈的过程中,聚合商通过制定最优充放电价实现自身运营收益最大;电动汽车用户在满足自身活动-出行的前提下优化充放电决策实现用车成本最低,双方实现收益的均衡。},
  collaborator = {{张凯}},
  langid = {chinese},
  school = {南京信息工程大学},
  keywords = {,-,/unread},
  annotation = {major: 电子信息（专业学位）\\
download: 349\\
album: 工程科技II辑\\
CLC: U491.8;TM73\\
