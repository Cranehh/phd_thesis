@inproceedings{strunzCoOPV2VbasedCooperative2021,
  title = {{{CoOP}}: {{V2V-based Cooperative Overtaking}} for {{Platoons}} on {{Freeways}}},
  shorttitle = {{{CoOP}}},
  booktitle = {2021 {{IEEE International Intelligent Transportation Systems Conference}} ({{ITSC}})},
