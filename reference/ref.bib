filename: 1024700166.nh},
  file = {/Users/haohe/Zotero/storage/98LHCGXY/齐琪 - 2024 - 不同行为假设下的准动态交通分配模型研究.pdf}
}

@article{qiuHybridMultiagentReinforcement2022,
  title = {Hybrid {{Multiagent Reinforcement Learning}} for {{Electric Vehicle Resilience Control Towards}} a {{Low-Carbon Transition}}},
  author = {Qiu, Dawei and Wang, Yi and Zhang, Tingqi and Sun, Mingyang and Strbac, Goran},
  year = 2022,
  journal = {IEEE Transactions on Industrial Informatics},
  volume = {18},
  number = {11},
  pages = {8258--8269},
  publisher = {IEEE},
  issn = {19410050},
  doi = {10.1109/TII.2022.3166215},
  abstract = {In responseto low-carbon requirements, a large amount of renewable energy resources (RESs) have been deployed in power systems; nevertheless, the intermittency of RESs raises the system vulnerability and even causes severe damage under extreme events. Electric vehicles (EVs), owing to their mobility and flexibility characteristics, can provide various ancillary services meanwhile enhancing system resilience. The distributed control of EVs under such scenarios in power-transportation network becomes a complex decision-making problem with enormous dynamics and uncertainties. To this end, a multiagent reinforcement learning method is proposed to compute both discrete and continuous actions simultaneously that aligns with the nature of EV routing and scheduling problems. Furthermore, the proposed method can enhance the learning stability and scalability with privacy perseverance in the multiagent setting. Simulation results based on IEEE 6-and 33-bus power networks integrated with transportation systems validate its effectiveness in providing system resilience and carbon intensity service.},
  keywords = {Carbon intensity,electric vehicles (EVs),multiagent reinforcement learning (MARL),power-transportation network,resilience},
  file = {/Users/haohe/Zotero/storage/PUBFEJWW/Hybrid_Multiagent_Reinforcement_Learning_for_Electric_Vehicle_Resilience_Control_Towards_a_Low-Carbon_Transition.pdf}
}

@phdthesis{QiuShuRongJiYuKeJieShiXingJiQiXueXiDeHuoDongChuXingLianXuQiuJianMo2023,
  type = {{硕士学位论文}},
  title = {{基于可解释性机器学习的活动-出行链需求建模}},
  author = {{邱树荣}},
  year = 2023,
  doi = {10.27014/d.cnki.gdnau.2023.001221},
  urldate = {2025-05-26},
  abstract = {伴随着新型城镇化的深入推进,城市空间总体上已由增量发展向存量优化过渡,引起交通需求的转变,导致传统四阶段需求模型不再普遍适用。依靠多源数据、互联网、云计算、人工智能等新兴技术的发展应用,得以作为基于活动的出行需求预测模型(ABM)实施建成的技术支撑。本文对已有国内外基于活动的出行需求模型进行了梳理,并针对以随机效用理论为基础的ABM预测性低,以机器学习为基础的ABM可解释性差的问题,提出基于可解释性机器学习的活动-出行链需求建模方法,为城市交通整体解决方案升级和精细化管理提供技术支持。本文首先融合多源数据对居民出行特征进行提取,包括现状多模式出行时间的阻抗矩阵提取,以及基于手机信令数据进行活动点、职住点识别和活动链重构。其次厘清ABM模型的逻辑框架,从上到下搭建了由长期选择层、活动生成层和单次出行层的模型框架,分析了影响人类活动和出行需求的特征因素,并根据现实人类活动出行决策的选择过程,探讨了基于活动的居民出行选择模型的模块结构,通过33个基于可解释性机器学习的子模型,实现个体的长期选择预测以及日活动出行安排。除了训练过程的精度描述外,还利用机器学习的可解释方法对各模型结果进行解释,并从宏观层面对各个模型进行了精度评估与参数标定。最后,将ABM与人口生成和动态交通分配进行融合,结合开源的Population Sim人口生成技术以及MATSim多智能体微观模拟仿真技术,提出了上衔人口生成,下接微观动态仿真的基于活动方法的出行需求预测系统框架。基于系统框架针对重庆市的限号政策进行了出行需求预测的案例分析:首先介绍了案例的具体实施过程,其次分析了限号前后的预测结果,从集计和非集计两个层面比较了限号前后出行需求的变化情况,以及相关限号路段流量与时耗和延误指数的变化,体现了模型的政策敏感性,以及实际落地的可行性和实用性。},
  collaborator = {{李大韦} and {孙宝}},
  langid = {chinese},
  school = {东南大学},
  keywords = {,-,/unread},
  annotation = {major: 交通运输（专业学位）\\
foundation: 国家重点研发计划项目(编号 2022YFB4300300,2018YFB1600900)； 国家自然科学基金项目(编号71971056)；\\
