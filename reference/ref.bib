@misc{yaoInvestigatingWillingnessShifting2024,
  type = {{{SSRN Scholarly Paper}}},
  title = {Investigating the {{Willingness}} of {{Shifting}} to {{MaaS}} in {{One-Trip Scenarios}}: {{Insights From Comparative Stated Surveys}}},
  shorttitle = {Investigating the {{Willingness}} of {{Shifting}} to {{MaaS}} in {{One-Trip Scenarios}}},
  author = {Yao, Enjian and Hao, He and Pan, Long and Chen, Rongsheng and Wang, Yue and Xiao, Hui},
  year = 2024,
  month = apr,
  number = {4782633},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4782633},
  urldate = {2024-04-22},
  abstract = {Considered as a potential solution to reduce carbon emissions, Mobility-as-a-Service (MaaS) is crucial for developing eco-friendly traffic systems. However, how to guide users to shift to MaaS at its early stage still needs more insights. Motivated by this, we conducted a stated preference survey in Beijing with a novel experiment manner, which provides respondents with comparative scenarios to ask them to focus on differences between MaaS options and their previous choice. Further, a latent-class-based model is developed, integrating travel habit and cross-scenario variables collected from the comparative SP experiments. According to the estimation results, we obtain two classes. The first represents respondents who tend to be familiar with MaaS and use shared mobility, and the other represents car enthusiasts. With respect to the preferences of these two classes, respondents in the former class may generate higher utility for all MaaS options. That said, they also tend to keep their mode choice in the scenario without MaaS when they choose private cars or taxis. On the contrary, respondents in the latter class may be negative about all MaaS options. Despite this, the previous mode choice of public transportation (PT) positively affects choosing MaaS options including PT. Further, we propose the shifting to MaaS index to quantify willingness to shift to MaaS. Our findings demonstrate that respondents in class 1 are much more likely to shift to MaaS and decreasing trip time does not have a strong effect on shifting to MaaS. Accordingly, some insights and suggestions are proposed for MaaS development, including cities suitable for MaaS, promotional strategies, and resource-optimization strategies.},
  langid = {english},
  keywords = {Behavior change,Latent class model,Mobility as a Service,Stated preference survey,Willingness to shift to MaaS},
  file = {/Users/haohe/Zotero/storage/DWVJXH3M/Yao 等 - 2024 - Investigating the Willingness of Shifting to MaaS .pdf}
}

