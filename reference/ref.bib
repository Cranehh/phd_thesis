@phdthesis{XieHaoSongKongYuTongXingNengLiJianMoHeYouHuaYanJiu2022,
  type = {{硕士学位论文}},
  title = {{空域通行能力建模和优化研究}},
  author = {{谢昊松}},
  year = 2022,
  urldate = {2025-10-08},
  abstract = {随着中国民用航空运输业的迅速发展,持续增长的交通需求与有限的空域资源之间的矛盾愈发明显。民航局空管局指出通行能力研究不仅是缓解空域拥挤的有效途径,还是平衡空域资源供需矛盾,继而实现空域资源最优配置的重要依据。另一方面,从空域精细化管理的角度来看,通行能力能更好反映空域内部在各个时段的实际交通服务能力,还可为民航空管系统制定科学合理且有效的流量管理措施提供指导。由于通行能力研究对于提高空域运行效率具有重要意义,故本文从扇区、空中高速路、航路网络这三个与空域运行效率最为相关的空域要素来展开通行能力研究。第一,针对繁忙扇区受进出交通影响,且缺乏相应的通行能力评估工具这一问题。基于对交通流模式的识别与分析,提出了航迹规整度、阻碍时间等扇区运行特征的概念,另结合进出交通流的构成和运行特征来改进理论通行能力模型,从而得到进出交通影响下的通行能力模型。基于对扇区内部航路、交叉点通行能力的研究基础,建立扇区通行能力评估模型。最后以实例验证了评估模型的有效性,可为空中交通管制员放行航空器提供辅助决策支持。并进一步揭示了空中交通流的时空特性对扇区通行能力有显著影响。第二,针对空中高速路交通流表现出的明显空中跟驰现象,运用跟驰理论对交通流跟驰稳定性进行推导,得出了适用于空中高速路交通流的稳定跟驰条件,并有助于使交通流趋于同质化运行,进而发挥空中高速路最大效能。基于对空中高速路交通流稳定跟驰行为的分析,建立其通行能力计算模型,并以无锡---邳县段空中高速路为例,所建模型更能反映实际交通运行情况,可以为空管部门管制员制定精准的管制指挥预案提供依据。第三,结合复杂网络理论及其相关指标,以中国西部空域部分骨干航路网络为例,分析了航路网络统计特征以及复杂特性。鉴于航路网络受突发事件易给民用航空运输带来负面效应,通过设计相应的仿真场景来模拟突发事件导致的离场航路阻断,在突发事件下基于系统最优原则进行航路网络通行能力调整优化,可以为民航空管部门缓解航路网络拥堵、降低航班延误提供解决方案。},
