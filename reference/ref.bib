@article{kimImputingQualitativeAttributes2022,
  title = {Imputing Qualitative Attributes for Trip Chains Extracted from Smart Card Data Using a Conditional Generative Adversarial Network},
  author = {Kim, Eui-Jin and Kim, Dong-Kyu and Sohn, Keemin},
  year = 2022,
  month = apr,
  journal = {Transportation Research Part C: Emerging Technologies},
  volume = {137},
