@article{khachmanIntegratedMultiresolutionFramework2024,
  title = {Integrated Multiresolution Framework for Spatialized Population Synthesis},
  author = {Khachman, Mohamed and Morency, Catherine and Ciari, Francesco},
  year = 2024,
  month = jun,
  journal = {Transportation},
