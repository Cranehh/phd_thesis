}

@article{yangDrivingCommutingTravel2021,
  title = {Driving as a Commuting Travel Mode Choice of Car Owners in Urban {{China}}: {{Roles}} of the Built Environment},
  shorttitle = {Driving as a Commuting Travel Mode Choice of Car Owners in Urban {{China}}},
  author = {Yang, Liya and Ding, Chuan and Ju, Yang and Yu, Bin},
