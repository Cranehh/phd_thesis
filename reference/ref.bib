@inproceedings{liuLearningDemonstrationSituationAdaptive2020,
  title = {Learning from {{Demonstration}}: {{Situation-Adaptive Lane Change Trajectory Planning}} for {{Automated Highway Driving}}},
  shorttitle = {Learning from {{Demonstration}}},
  booktitle = {2020 {{IEEE International Conference}} on {{Mechatronics}} and {{Automation}} ({{ICMA}})},
  author = {Liu, Yulong and Liu, Yahui and Ji, Xuewu and Sun, Liting and Tomizuka, Masayoshi and He, Xiangkun},
