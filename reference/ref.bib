  doi = {10.1016/j.apgeog.2024.103260},
  urldate = {2025-12-10},
  abstract = {Mobile big data has emerged as an essential tool for various scientific research fields. However, the credibility of mobile big data and the extent to which it can represent the real-world population remain unclear. This study evaluated the representativeness of mobile big data by comparing it to the most recent census data at the county level in China. Using power-law and multiple linear regression models, we aim to determine the accuracy and reliability of mobile big data in reflecting the population dynamics and characteristics of different geographical areas. Our results indicate that disparities among individuals with different socioeconomic statuses, demographic characteristics, or geographic locations may contribute to biased estimations of the actual population density. Higher illiteracy rates and median ages may be associated with underestimating population density. In contrast, higher GDP per capita, elevated urbanization levels, and larger percentages of the 15--64 year age group may be associated with overestimating population density. Our research highlights the importance of cross-validating population estimates and offering practical statistical methods for addressing potential biases and estimating population dynamics in future applications of mobile big data.},
  keywords = {/unread,Baidu,Census,China,County,Location-based data,Mobile big data},
  file = {/Users/haohe/Zotero/storage/VY7BVXPT/Mu 等 - 2024 - Evaluating the representativeness of mobile big data A comparative analysis between China's mobile.pdf;/Users/haohe/Zotero/storage/KCSKSALU/S0143622824000651.html}
}

@article{muhammadDeepLearningSafe2021,
  title = {Deep {{Learning}} for {{Safe Autonomous Driving}}: {{Current Challenges}} and {{Future Directions}}},
  author = {Muhammad, Khan and Ullah, Amin and Lloret, Jaime and Ser, Javier Del and De Albuquerque, Victor Hugo C.},
  year = 2021,
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  volume = {22},
  number = {7},
  pages = {4316--4336},
  issn = {15580016},
  doi = {10.1109/TITS.2020.3032227},
  abstract = {Advances in information and signal processing technologies have a significant impact on autonomous driving (AD), improving driving safety while minimizing the efforts of human drivers with the help of advanced artificial intelligence (AI) techniques. Recently, deep learning (DL) approaches have solved several real-world problems of complex nature. However, their strengths in terms of control processes for AD have not been deeply investigated and highlighted yet. This survey highlights the power of DL architectures in terms of reliability and efficient real-time performance and overviews state-of-the-art strategies for safe AD, with their major achievements and limitations. Furthermore, it covers major embodiments of DL along the AD pipeline including measurement, analysis, and execution, with a focus on road, lane, vehicle, pedestrian, drowsiness detection, collision avoidance, and traffic sign detection through sensing and vision-based DL methods. In addition, we discuss on the performance of several reviewed methods by using different evaluation metrics, with critics on their pros and cons. Finally, this survey highlights the current issues of safe DL-based AD with a prospect of recommendations for future research, rounding up a reference material for newcomers and researchers willing to join this vibrant area of Intelligent Transportation Systems.},
  keywords = {artificial intelligence,Autonomous driving (AD),decision making,deep learning (DL),intelligent sensors,vehicular safety,vehicular technology},
  file = {/Users/haohe/Zotero/storage/IRYZ2QKK/Deep_Learning_for_Safe_Autonomous_Driving_Current_Challenges_and_Future_Directions.pdf}
}

@phdthesis{MuJianGuangJianSheQingDaoXianDaiZongHeYunShuTiXiLuJingTanTao2011,
  type = {{硕士学位论文}},
  title = {{建设青岛现代综合运输体系路径探讨}},
  author = {{慕建光}},
  year = 2011,
  month = mar,
  doi = {10.7666/d.Y1935886},
  urldate = {2026-01-19},
  abstract = {随着建设山东半岛蓝色经济区战略的实施和青岛市建设现代化国际城市进程的不断加快,探索青岛现代综合运输体系发展路径成为一项十分紧迫的任务。国内外先进城市交通发展经验表明,构建现代综合运输体系是经济社会发展到一定阶段的必然选择和必由之路。加快青岛现代综合运输体系的建立不仅能满足不断增长的客货运输需求,而且符合城市可持续发展的要求,并且能够发挥各种运输方式的比较优势,实现不同运输方式的无缝衔接,这对于提升青岛城市核心竞争力、巩固山东半岛城市群的龙头地位都有着极大的推动作用。 本文首先阐述了国内外关于综合运输理论和实践的研究,明确了综合运输的概念和内涵。然后从运送速度、运输成本、劳动生产率、能源消耗、初始投资、环境保护等方面,对各种运输方式技术经济特征做了比较分析,提出了各自的优劣势。其次介绍了青岛市综合运输体系发展现状,分别阐述了各种运输方式的发展情况以及综合运输体系发展情况及存在的问题。再次从青岛市运输需求影响因素入手,预测了各种运输方式的客货运输需求情况。最后提出青岛市综合运输体系的发展对策,即以构建北连环渤海、南接长三角、向西辐射沿黄流域的环湾型现代化国际城市为取向,立足发挥青岛海港区位优势,按照各类运输方式技术经济特征和比较优势,在现有的综合运输体系基础上,优先发展水路运输和铁路运输,打造重点突出、布局完善、衔接顺畅、信息支撑的现代综合运输体系,核心任务主要是建设好``两大系统'':集约的基础设施网络系统和高效的组织保障服务系统。集约的基础设施网络系统,从点、线、面,即枢纽、通道、网络三个层面统筹考虑不同运输方式之间的基础设施的衔接、优化和协调;高效的组织保障服务系统,从综合运输体系的组织协调、综合运输建设投融资体制、运输服务信息化建设等层面加以重点保障,最终把青岛建成以东北亚国际航运中心为核心,以铁路、公路、水路、航空为辐射载体的现代综合运输体系,满足青岛市日益增长的交通运输需求,巩固提升全国综合交通枢纽城市。},
  collaborator = {{姜杰}},
  langid = {chinese},
  school = {山东大学},
  keywords = {,/unread},
