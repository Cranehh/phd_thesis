@article{hensherMobilityServicePrivate2021,
  title = {Mobility as a Service and Private Car Use: {{Evidence}} from the {{Sydney MaaS}} Trial},
  author = {Hensher, David A. and Ho, Chinh Q. and Reck, Daniel J.},
