@article{guanReferencePointsTravel2023,
  title = {Reference Points in Travel Satisfaction: {{Travel}} Preference, Travel Experience, or Peers' Travel?},
  shorttitle = {Reference Points in Travel Satisfaction},
  author = {Guan, Xiaodong and Zhou, Meng and Wang, Donggen},
