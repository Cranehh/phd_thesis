  keywords = {Accessibility,High-speed railway,Inter-city travel,Multi-modal network,Multi-scalar},
  file = {/Users/haohe/Zotero/storage/R78N822G/Dai 等 - 2025 - High-speed rail impacts on intercity accessibility A multi-modal, multi-scalar networking approach.pdf;/Users/haohe/Zotero/storage/NGHT6CDJ/S0968090X25000105.html}
}

@article{dalyUsingOrderedAttitudinal2012,
  title = {Using Ordered Attitudinal Indicators in a Latent Variable Choice Model: A Study of the Impact of Security on Rail Travel Behaviour},
  shorttitle = {Using Ordered Attitudinal Indicators in a Latent Variable Choice Model},
  author = {Daly, Andrew and Hess, Stephane and Patruni, Bhanu and Potoglou, Dimitris and Rohr, Charlene},
  year = 2012,
  month = mar,
  journal = {Transportation},
  volume = {39},
