@article{yousefzadehbarriCanTransitInvestments2021,
  title = {Can Transit Investments in Low-Income Neighbourhoods Increase Transit Use? {{Exploring}} the Nexus of Income, Car-Ownership, and Transit Accessibility in {{Toronto}}},
  shorttitle = {Can Transit Investments in Low-Income Neighbourhoods Increase Transit Use?},
  author = {Yousefzadeh Barri, Elnaz and Farber, Steven and Kramer, Anna and Jahanshahi, Hadi and Allen, Jeff and Beyazit, Eda},
  year = 2021,
