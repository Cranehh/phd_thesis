@article{kriswardhanaSystematicLiteratureReview2023,
  title = {A Systematic Literature Review of {{Mobility}} as a {{Service}}: {{Examining}} the Socio-Technical Factors in {{MaaS}} Adoption and Bundling Packages},
  author = {Kriswardhana, Willy and {Eszterg{\'a}r-Kiss}, Domokos},
  year = 2023,
