@phdthesis{WangYuXiaKaoLuCheLiangPaiFangKuoSanYingXiangDeDongTaiJiaoTongFenPeiMoXingYanJiu2022,
  type = {{硕士学位论文}},
  title = {{考虑车辆排放扩散影响的动态交通分配模型研究}},
  author = {{王玉霞}},
  year = 2022,
  doi = {10.27411/d.cnki.gscgc.2022.000472},
  urldate = {2025-05-26},
  abstract = {由于社会的进步和国民经济的快速发展,我国城市机动车总量迅速扩大,其污染物排放量也日趋增多,已经成为城市大气污染的主要来源。除此之外,车辆尾气作为近地污染物排放源,扩散后直接进入路旁人群呼吸带,对人体健康危害程度高于高架源排放,而路旁人群密度越高,尾气污染带来的健康影响越大。因此将车辆排放扩散影响控制作为优化目标函数时,不仅要关注车辆总排放量,还应保证受排放影响的路旁人数尽量少。目前,除了改善机动车性能以降低排放影响外,交通分配管理也是改善城市车辆尾气排放扩散影响的重要方法。本文综合考虑车辆排放扩散影响控制,对动态交通分配相关理论进行研究,为改善城市交通污染扩散对大气环境及路旁人群影响提供理论依据。首先,考虑到不同类型车辆排放因子的差异性,本文构建了适用于动态交通分配模型的多车型元胞传输模型,更真实地反映路段交通流特性,便于探究时变交通特性对车辆排放的影响。其次,基于多车型元胞传输模型,计算车辆在路段上的出行时间。并通过比较相邻元胞间交通流情况,确定车辆在元胞内的行驶工况。根据不同行驶工况下车辆的平均排放率,建立考虑行驶工况的多车型排放模型。同时引入路旁人群暴露风险概念,给出路旁人群吸入车辆排放污染物总量的计算方法。通过车辆排放量和路旁人群暴露风险综合描述车辆排放扩散影响。对车辆实际出行时间、多车型排放量及路旁人群暴露风险加权平均建立考虑车辆尾气排放扩散影响的广义阻抗函数。然后,在蚁群系统算法的基础上,考虑智能化设施普及与大家环保意识提升的背景下出行者实际择路特征,将考虑车辆排放扩散影响的广义阻抗函数代入动态用户最优分配模型,替换原有时间阻抗函数。同时针对现有蚁群系统算法的不足加以改进,设计基于广义阻抗的自适应反馈机制,提出自适应蚁群系统算法,然后再利用该算法对上述动态交通分配模型加以求解。并进行算例分析,验证本文提出的模型和算法的合理化及有效性。最后,在以上模型的基础上,提出不同的车辆排放扩散影响管理方法,为实际制定控制车辆排放扩散影响的交通管理策略提供参考。},
  collaborator = {{曾传华}},
