@article{wongEffectsAccessibilityTransit2015,
  title = {Effects of {{Accessibility}} to the {{Transit Stations}} on {{Intercity Mode Choices}} in {{Contexts}} of {{High Speed Rail}} ({{HRS}}) in the {{Windsor-Quebec Corridor}} in {{Canada}}},
  author = {Wong, Billy and Nurul Habib, Khandker},
  year = 2015,
