@article{echavarrenGenderGapEnvironmental2023,
  title = {The {{Gender Gap}} in {{Environmental Concern}}: {{Support}} for an {{Ecofeminist Perspective}} and the {{Role}} of {{Gender Egalitarian Attitudes}}},
