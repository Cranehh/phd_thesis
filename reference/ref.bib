  year = 2007,
  month = jun,
  journal = {Transportation Research Part A: Policy and Practice},
  series = {Bridging {{Research}} and {{Practice}}: {{A Synthesis}} of {{Best Practices}} in {{Travel Demand Modeling}}},
  volume = {41},
