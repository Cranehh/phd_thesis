@phdthesis{LiuGuangYunJiYuMaErKeFuLianDeZiZhuShiJiaoTongXiTongJiaGouKeKaoXingPingGu2022,
  type = {{硕士}},
  title = {{基于马尔可夫链的自主式交通系统架构可靠性评估}},
  author = {{刘光昀}},
  year = 2022,
  abstract = {自主式交通系统(Autonomous Transportation System,ATS)架构概念的提出,不但符合目前科技的高速发展和交通基础设施建设的进一步完善,并且参考了未来交通的发展方向。相比于美国、日本提出的ITS(Intelligent Transportation System,ITS),ATS架构更加适用于我国当前国情。然而,自主式交通系统架构目前仍旧处于起步阶段,为了保证ATS架构的顺利运行,本文针对ATS架构提出了可靠性评估问题的研究工作。首先,ATS架构中包括三个架构,分别为物理架构、功能架构和逻辑架构,其在运作逻辑上类似于软件结构,但是在实际运行过程中与硬件的失效状态相关,故结合ATS架构和软硬件系统中可靠性评估参数的特点,选取了失效率、占有率和重要度三个参数对ATS架构进行了可靠性评估。其次,本文构建了可靠性评估模型,用失效率、占有率和重要度三个参数计算单个组件的可靠性和系统整体可靠性。由于复杂交通系统本身处于可维修状态,故选取了马尔可夫链方法计算失效率,利用统计方法计算占有率,利用Page Rank算法计算重要度。主要目的是通过组件的使用频率和在结构上的重要度强调失效率对系统的影响,从而计算整个系统的可靠性。此外,本文开发了ATS架构可靠性评估系统。从系统的物理架构、功能架构和逻辑架构的角度,分别对系统的物理组成、功能结构和数据流转进行了描述,利用Python语言、Mysql数据库、Springboot框架、Java Script语言以及Vue框架开发了前后端分离的ATS架构可靠性评估系统,对评估的结果进行展示,方便可靠性评估的使用人员对ATS架构进行可靠性评估。最后,为了验证本文中提出的方法,基于系统动力学原理设计的仿真平台对车辆环境感知子服务的ATS架构场景进行了流量仿真,利用仿真数据和本文提出的ATS架构中的可靠性评估模型,对该仿真案例进行了各参数的计算,分析了各组件的失效率、占有率、重要度、部分可靠性,以及系统的整体可靠性,并对这些参数的变化趋势进行了相应的绘制展示和分析。},
  collaborator = {{程绍武}},
  langid = {chinese},
  school = {哈尔滨工业大学},
  keywords = {,Autonomous transportation system architecture,Failure rate,Markov chain,Reliability assessment},
  file = {/Users/haohe/Zotero/storage/4QFT2FZM/基于马尔可夫链的自主式交通系统架构可靠性评估_刘光昀.pdf}
}

@article{liuHighTemporalspatialVehicle2018,
  title = {A High Temporal-Spatial Vehicle Emission Inventory Based on Detailed Hourly Traffic Data in a Medium-Sized City of {{China}}},
  author = {Liu, Yong Hong and Ma, Jin Ling and Li, Li and Lin, Xiao Fang and Xu, Wei Jia and Ding, Hui},
  year = 2018,
  month = may,
  journal = {Environmental Pollution},
  volume = {236},
  pages = {324--333},
  publisher = {Elsevier},
  issn = {0269-7491},
  doi = {10.1016/J.ENVPOL.2018.01.068},
  urldate = {2021-12-02},
  abstract = {To improve the accuracy and temporal-spatial resolution for a vehicle emission inventory in a medium-sized city with a strip road network, this study was conducted based on detailed hourly traffic-flow data for each day of 2014, and covered all road types and regions in the city of Foshan. Detailed hourly emission characteristics and sources in five regions were analysed. The results showed that the total vehicle emissions of CO, NOX, VOCs, and PM2.5 were 13.10 \texttimes{} 104, 0.23 \texttimes{} 104, 4.46 \texttimes{} 104, and 0.18 \texttimes{} 104 tons, respectively. Motorcycles (MCs) and light passenger cars (LPCs) were the dominant contributors of CO emissions, while buses and heavy passenger cars (HPCs) were the dominant contributors for NOX. As a whole, the daytime contributions to total emissions were close to 80\%, and emissions during the peak periods accounted for almost 40\%. Specifically, the hourly emissions of each pollutant on workdays were higher than on non-workdays (maximum up to 64.2\%), and for some roads the early peak periods changed significantly from workdays to non-workdays. At expressways, artery roads, and local roads, the daily emission intensities of CO, NOx, and PM2.5 in Foshan were close to or even higher than that of Beijing. On a regional scale, the temporal variation of vehicle emissions on workdays at artery roads of different regions were similar. In addition, the higher emission intensities of CO and VOCs were identified in DaLiang-RongGui (DLRG) and that of NOX and PM2.5 were in Central Region (CR). These results are meaningful for decision-makers to help provide more detailed vehicle pollution control measures in Foshan with a strip road network and only one ring road. The work establishes a basis for further research that evaluates the impacts of emission reduction policies in medium-sized cities with a strip road network and only one ring road.},
  pmid = {29414354},
  keywords = {Detailed hourly traffic data,Foshan,Medium-sized city,Vehicle emission inventory},
  file = {/Users/haohe/Zotero/storage/DR49SA4Q/full-text.pdf}
}

