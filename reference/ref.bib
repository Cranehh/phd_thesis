  author = {{陈帅}},
  year = 2022,
  abstract = {高速铁路以其快速安全、舒适便捷等特点,已逐渐发展成为公共交通的主动脉和国民经济的重要组成。目前我国高速铁路已经进入网络化运营时代,高速铁路网络的日益复杂和行车密度的不断增强对列车高效稳定运行提出更大的挑战。恶劣天气或设备故障等突发事件导致列车非正常停车和大范围列车延误,影响整个网络的正常运营和旅客满意度下降,甚至会造成重大经济损失和恶劣的社会影响。因此,突发事件下快速准确的预测延误影响的时空范围,以提升成网条件下高铁应对突发事件的处置能力,具有重要的理论与现实意义。然而高速铁路是安全严苛的实际运营系统,无法进行延误的推演相关试验,而数字孪生技术可以实现数字空间与物理空间的状态一致性,实时观测物理系统的状态,并在数字空间进行推演,可有效提升延误预测的实时性和效率。本文提出基于深度学习的列车延误预测方法并基于数字孪生技术构建列车延误预测原型系统提升预测的性能,主要内容如下:首先,针对突发事件下列车延误时间难以精准预测问题,提出基于深度学习的列车延误预测方法。考虑延误致因多样性、运行信息异质性和延误样本分布不均等问题,采用K-means算法对延误信息分类并基于高斯噪声方法对数据实现分类增强,并构建基于XGBoost的特征重要性评估方法实现数据特征的学习和提取。进一步提出基于Transformer和FCN的多模态神经网络模型来预测列车延误,通过与基线模型进行对比,该算法预测精度提升10\%以上,验证了算法的准确性。其次,针对轨道交通网络耦合机理复杂难以实现高效路网延误预测问题,提出基于图神经网络的路网延误同步预测方法。考虑延误传播、路网节点异质和异步预测时滞性等问题,构建以列车到发事件为节点、行车关系为边的车-路事件网络模型。在此基础上提出时空图神经网络挖掘高铁路网内节点空间关系再与时间序列模型结合提取路网的时空特征,最终实现典型场景下的路网延误同步预测目标。通过结合实绩数据进行仿真验证,预测精度提升9\%以上。最后,设计基于数字孪生的列车延误预测原型系统。分析系统的设计目标和需求,提取物理系统中高铁路网线路信息、列车运行时刻表和运行环境等关键参数并基于B/S架构和地理信息技术构建孪生体。基于数字孪生系统构建规则建立面向延误预测的列车延误预测系统多层架构,并对各层之间的耦合机理进行分析。进一步采用Web开发、Django、数据库等技术搭建系统原型及运行监控和延误预测两大功能模块,基于实际案例数据对系统的功能和预测结果进行测试与分析。图45幅,表12个,参考文献102篇。},
  collaborator = {{董海荣}},
  langid = {chinese},
  school = {北京交通大学},
  keywords = {,Deep learning,Digital twin,High-speed railway network,Train delay prediction},
  file = {/Users/haohe/Zotero/storage/DHTXU59B/基于深度学习的列车延误预测及其数字孪生原型系统设计_陈帅.pdf}
}

@article{ChenSiYuJiYuChongTuXiangWeiZuDeZiDongJiaShiJiaoChaKouXingRenGuoJieKongZhiFangFa2024,
  title = {{基于冲突相位组的自动驾驶交叉口行人过街控制方法}},
  author = {{陈思雨} and {吴伟}},
  year = 2024,
  journal = {长沙理工大学学报(自然科学版)},
  volume = {21},
  number = {1},
  pages = {150-163+173},
  issn = {1672-9331},
  doi = {10.19951/j.cnki.1672-9331.20230730001},
  urldate = {2024-05-06},
  abstract = {【目的】在无信号控制的自动驾驶环境下，自动驾驶车辆的通行轨迹将与过街行人产生大量冲突，如何利用交通控制手段使行人安全通过交叉口，并避免对自动驾驶车辆的通行造成较大的干扰，是亟待解决的关键问题。【方法】本文提出一种基于冲突相位组的自动驾驶交叉口行人过街控制方法，将到达交叉口的车辆流向分为4个冲突相位组，在各相位组内单独分配通行时间，基于冲突相位组对自动驾驶车辆和行人过街的通行时间进行建模；在穿插式通行模式的基础上，使用行人信号灯保障行人过街需求，建立考虑行人二次过街的自动驾驶交叉口交通控制模型。模型以交叉口各流向需求量与实际交通量乘积之和最大为目标，以各流向允许车辆通行的时间比例和行人信号灯状态为决策变量，综合考虑交通流量、行人和车辆通行权等约束，建立混合整数线性规划模型（mixed-integer linear program,MILP），该控制模型可为各流向的车辆和行人分配通行权。【结果】本文模型的车均延误较定时控制方案的降低26.74\%，较单次过街模型的降低11.53\%，人均延误较定时控制方案的降低51.66\%，较单次过街模型的降低36.20\%。这表明本文模型能有效提升交叉口的通行效率。【结论】本文模型能根据自动驾驶车辆和行人的通行需求，对交叉口时空通行权进行分配，有效保障行人过街安全。},
  langid = {chinese},
  file = {/Users/haohe/Zotero/storage/6GALKR8D/陈 和 吴 - 2024 - 基于冲突相位组的自动驾驶交叉口行人过街控制方法.pdf}
}

@article{chenSpatialtemporalPricingRidesourcing2021,
  title = {Spatial-Temporal Pricing for Ride-Sourcing Platform with Reinforcement Learning},
  author = {Chen, Chuqiao and Yao, Fugen and Mo, Dong and Zhu, Jiangtao and Chen, Xiqun (Michael)},
  year = 2021,
  journal = {Transportation Research Part C: Emerging Technologies},
  volume = {130},
  number = {July},
  pages = {103272},
  publisher = {Elsevier Ltd},
  issn = {0968090X},
  doi = {10.1016/j.trc.2021.103272},
  abstract = {Ever since the emergence of ride-sourcing services, the spatial--temporal pricing problem has been a hot research topic in both the transportation and management fields. The difficulty lies in simultaneously obtaining the optimal multivariable solution for spatial pricing and sequential solution for dynamic pricing, considering the heterogeneity, dynamics, and imbalance of on-demand ride supply/demand. Due to this problem's complexity, most studies have simplified the modeling setting and omitted the complicated matching and waiting process between drivers and passengers. To go beyond the existing models, this paper proposes a reinforcement learning enhanced agent-based modeling and simulation (RL-ABMS) system to reveal the complex mechanism in the ride-sourcing system and tackle the problem of spatial--temporal pricing for a ride-sourcing platform. The reinforcement learning approach proximal policy optimization (PPO) is implemented in the RL-ABMS system, where two feed-forward neural networks are built as critic and actor. The critic judges the goodness of the current state, and the actor generates the optimal pricing strategy. Compared with the fixed pricing strategy, the experimental results on a real-world urban network show that dynamic pricing raises the platform's profit to 1.25 times, and spatial--temporal pricing even raises it to 1.85 times. Besides, the number of idle drivers/vehicles has significantly dropped under the spatial--temporal pricing strategy, which indicates that our proposed strategy has a remarkable effect on coordinating supply and demand in the ride-sourcing market.},
  keywords = {Agent-based modeling and simulation,Proximal policy optimization (PPO),Reinforcement learning,Ride-sourcing,Spatial-temporal pricing},
  annotation = {TLDR: A reinforcement learning enhanced agent-based modeling and simulation (RL-ABMS) system is proposed to reveal the complex mechanism in the ride-sourcing system and tackle the problem of spatial--temporal pricing for a ride-Sourcing platform.},
  file = {/Users/haohe/Zotero/storage/T3LCWN56/chen2021.pdf}
}

@article{chenStabilitybasedAnalysisAutonomous2020,
  title = {Stability-Based Analysis of Autonomous Intersection Management with Pedestrians},
  author = {Chen, Rongsheng and Hu, Jeffrey and Levin, Michael W. and Rey, David},
  year = 2020,
  month = may,
  journal = {Transportation Research Part C: Emerging Technologies},
  volume = {114},
  pages = {463--483},
  issn = {0968-090X},
  doi = {10.1016/j.trc.2020.01.016},
  urldate = {2024-05-06},
  abstract = {With the development of vehicle-to-infrastructure and vehicle-to-vehicle technologies, vehicles will be able to communicate with the controller at the intersection. Autonomous driving technology enables vehicles to follow the instructions sent from the controller precisely. Autonomous intersection management considers each vehicle as an agent and coordinates vehicle trajectories to resolve vehicle conflicts inside an intersection. This study proposes an autonomous intersection management algorithm called AIM-ped considering both vehicles and pedestrians which is able to produce the total optimal throughput when combined with max pressure control. This study analyzes the stability properties of the algorithm based on a simpler version of AIM-ped, which is a conflict region model of the autonomous intersection management. To implement the proposed algorithm in simulation, this study combines the max-pressure control with an existing trajectory optimization algorithm to calculate optimal vehicle trajectories. Simulations are conducted to test the effects of pedestrian demand on intersection efficiency. The simulation results show that delays of pedestrians and vehicles are negatively correlated and the proposed algorithm can adapt to the change in the pedestrian demand and activate vehicle movements with conflicting trajectories.},
  keywords = {Autonomous intersection management (AIM),Max-pressure control,Pedestrians},
  annotation = {TLDR: This study analyzes the stability properties of the algorithm based on a simpler version of AIM-ped, which is a conflict region model of the autonomous intersection management, and combines the max-pressure control with an existing trajectory optimization algorithm to calculate optimal vehicle trajectories.},
  file = {/Users/haohe/Zotero/storage/F7DCWSQ7/Chen 等 - 2020 - Stability-based analysis of autonomous intersectio.pdf}
}

