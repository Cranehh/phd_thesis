  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2403.19098},
  urldate = {2025-08-08},
  abstract = {Modeling complicated interactions among the ego-vehicle, road agents, and map elements has been a crucial part for safety-critical autonomous driving. Previous works on end-to-end autonomous driving rely on the attention mechanism for handling heterogeneous interactions, which fails to capture the geometric priors and is also computationally intensive. In this paper, we propose the Interaction Scene Graph (ISG) as a unified method to model the interactions among the ego-vehicle, road agents, and map elements. With the representation of the ISG, the driving agents aggregate essential information from the most influential elements, including the road agents with potential collisions and the map elements to follow. Since a mass of unnecessary interactions are omitted, the more efficient scene-graph-based framework is able to focus on indispensable connections and leads to better performance. We evaluate the proposed method for end-to-end autonomous driving on the nuScenes dataset. Compared with strong baselines, our method significantly outperforms in the full-stack driving tasks, including perception, prediction, and planning. Code will be released at https://github.com/zhangyp15/GraphAD.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  annotation = {TLDR: The Interaction Scene Graph (ISG) is proposed as a unified method to model the interactions among the ego-vehicle, road agents, and map elements and significantly outperforms in the full-stack driving tasks, including perception, prediction, and planning.},
  file = {/Users/haohe/Zotero/storage/8BVIXAEE/Zhang 等 - 2024 - GraphAD Interaction Scene Graph for End-to-end Autonomous Driving.pdf;/Users/haohe/Zotero/storage/7PJTZLRH/2403.html}
}

@article{zhangHierarchicalDiffusionModels2025,
  title = {Hierarchical Diffusion Models for Generating Various Pattern Vehicles in Infrared Aerial Images},
  author = {Zhang, Nan and Liu, Youmeng and Liu, Hao and Tian, Tian and Ma, Jiayi and Tian, Jinwen},
  year = 2025,
  month = oct,
  journal = {Pattern Recognition},
  volume = {166},
  pages = {111658},
  issn = {0031-3203},
  doi = {10.1016/j.patcog.2025.111658},
  urldate = {2025-05-15},
  abstract = {Infrared vehicle detection based on aerial images has significant applications across various fields due to its ability to operate around the clock. Infrared images record thermal emissions, resulting in complex vehicle patterns that are shaped by environmental factors and vehicle dynamics. However, creating a comprehensive dataset for training a high-performance detection model poses considerable challenges. It requires labor-intensive efforts to collect a wide array of vehicle patterns. We define the pattern of a vehicle as the combination of grayscale and structure, which is influenced by the time period, imaging conditions, and the state of vehicle motion. In particular, the scarcity of specific categories of vehicles further exacerbates these challenges. To augment the dataset cost-effectively, we propose the Hierarchical Diffusion Model (HDM), designed to generate infrared vehicles with diverse patterns, thereby significantly enriching object diversity. The hierarchical architecture guarantees the superior quality of generated infrared vehicles across all scales. Simultaneously, we maintain the fidelity and diversity of the produced vehicles by conditioning the training and sampling processes on the structural and grayscale features of the vehicles. Furthermore, we introduce inpainting sampling to seamlessly integrate generated vehicles into images, avoiding grayscale distortions at the stitching pixels between the target patch and the background. Our experimental evaluations, conducted on the public DroneVehicle dataset, demonstrate the superior performance of our approach in generating infrared vehicle images and its subsequent advantages for detection tasks.},
  langid = {american},
  keywords = {Data augmentation,Diffusion model,Infrared aerial image,Vehicle detection},
  file = {/Users/haohe/Zotero/storage/J6PAVT58/Zhang 等 - 2025 - Hierarchical diffusion models for generating various pattern vehicles in infrared aerial images.pdf;/Users/haohe/Zotero/storage/XP6RZ526/S0031320325003188.html}
}

