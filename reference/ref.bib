@article{nohAnalyzingVehiclePedestrian2022,
  title = {Analyzing Vehicle--Pedestrian Interactions: {{Combining}} Data Cube Structure and Predictive Collision Risk Estimation Model},
  shorttitle = {Analyzing Vehicle--Pedestrian Interactions},
  author = {Noh, Byeongjoon and Park, Hansaem and Yeo, Hwasoo},
  year = 2022,
