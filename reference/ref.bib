  title = {The Role of Intermodality and Environmental Consciousness in the Preferences for {{MaaS}} Bundles: {{A}} Hybrid Choice Modeling Approach},
  shorttitle = {The Role of Intermodality and Environmental Consciousness in the Preferences for {{MaaS}} Bundles},
