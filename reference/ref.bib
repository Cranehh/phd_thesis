@phdthesis{ChengChuanLongJiYuZhiShiTuPuDeGaoSuGongLuYingJiJueCeTuiJianFangAnYanJiu2022,
  type = {{硕士}},
  title = {{基于知识图谱的高速公路应急决策推荐方案研究}},
  author = {{程传龙}},
  year = 2022,
  abstract = {近年来,我国机动车保有量和社会交通需求量增长显著,截至2020年,我国高速公路总里程已达16.10万公里,20万以上人口城市覆盖率近100\%。2016-2019年,我国高速公路年平均日交通量增长4.1\%,年平均日行驶量增长3.4\%。在高速公路建设短期滞后于交通量增长的背景下,高速公路路网压力持续增大,车流密集路段拥堵情况加剧,高速公路交通事故频发,整体运行效率下降,社会成本上升。为了解决高速公路突发交通事故处置方案决策的问题,本研究基于连徐高速事故数据,构建了高速公路事故信息与应急处置措施之间的知识图谱,并设计了基于知识图谱的高速公路应急决策方案。本文首先研究了高速公路突发事件及其分类、致因、影响因素和高速公路应急管理的组织体系、平台建设与业务流程,通过对高速公路相关因素的分析确定了基于知识图谱的应急决策推荐方案。其次对以文本形式存储的高速公路事故数据进行了处理,通过文本分词提取了事故信息关键词,运用关联规则挖掘分析了各事故致因之间、事故致因与处置措施之间的逻辑关系。再者使用相关软件进行了本体构建、数据源配置、知识抽取与映射、知识融合,构建了高速公路事故信息与应急处置措施之间的知识图谱。而后结合知识图谱嵌入方法设计了基于知识图谱的高速公路应急决策推荐方案,利用模板化CBS实现了基于知识图谱的方案推荐和索引问答服务。最后选取未参与图谱构建的事故数据进行了效果验证与质量评估,证明了基于知识图谱的高速公路应急决策推荐方案的可靠性。实例检验证明,本文研究的基于知识图谱的高速公路应急决策推荐方案可以根据事故类型和现场信息推荐较为合理的应急处置措施,推荐正确率为81\%,推荐平均用时为2.81秒。本文有图65幅,表26个,参考文献62篇。},
  collaborator = {{李鑫}},
  langid = {chinese},
  school = {中国矿业大学},
  keywords = {,Emergency Decision,Expressways,Knowledge Graph,Traffic Accidents},
