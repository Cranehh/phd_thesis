@article{spotswoodNatureInequityHigher2021,
  title = {Nature Inequity and Higher {{COVID-19}} Case Rates in Less-Green Neighbourhoods in the {{United States}}},
  author = {Spotswood, Erica N. and Benjamin, Matthew and Stoneburner, Lauren and Wheeler, Megan M. and Beller, Erin E. and Balk, Deborah and McPhearson, Timon and Kuo, Ming and McDonald, Robert I.},
  year = 2021,
