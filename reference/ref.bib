  title = {Within-Job Gender Pay Inequality in 15 Countries},
  author = {Penner, Andrew M. and Petersen, Trond and Hermansen, Are Skeie and Rainey, Anthony and Boza, Istv{\'a}n and Elvira, Marta M. and Godechot, Olivier and H{\"a}llsten, Martin and Henriksen, Lasse Folke and Hou, Feng and Mr{\v c}ela, Aleksandra Kanjuo and King, Joe and Kodama, Naomi and Kristal, Tali and K{\v r}{\'i}{\v z}kov{\'a}, Alena and Lipp{\'e}nyi, Zolt{\'a}n and Melzer, Silvia Maja and Mun, Eunmi and Apascaritei, Paula and {Avent-Holt}, Dustin and Bandelj, Nina and Hajdu, Gergely and Jung, Jiwook and Poje, Andreja and Sabanci, Halil and Safi, Mirna and Soener, Matthew and {Tomaskovic-Devey}, Donald and Tufail, Zaibu},
