@misc{zhangGraphADInteractionScene2024,
  title = {{{GraphAD}}: {{Interaction Scene Graph}} for {{End-to-end Autonomous Driving}}},
  shorttitle = {{{GraphAD}}},
  author = {Zhang, Yunpeng and Qian, Deheng and Li, Ding and Pan, Yifeng and Chen, Yong and Liang, Zhenbao and Zhang, Zhiyao and Zhang, Shurui and Li, Hongxu and Fu, Maolei and Ye, Yun and Liang, Zhujin and Shan, Yi and Du, Dalong},
