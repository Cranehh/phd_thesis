  abstract = {The goal of multi-task learning is to enable more efficient learning than single task learning by sharing model structures for a diverse set of tasks. A standard multi-task learning objective is to minimize the average loss across all tasks. While straightforward, using this objective often results in much worse final performance for each task than learning them independently. A major challenge in optimizing a multi-task model is the conflicting gradients, where gradients of different task objectives are not well aligned so that following the average gradient direction can be detrimental to specific tasks' performance. Previous work has proposed several heuristics to manipulate the task gradients for mitigating this problem. But most of them lack convergence guarantee and/or could converge to any Pareto-stationary point. In this paper, we introduce Conflict-Averse Gradient descent (CAGrad) which minimizes the average loss function, while leveraging the worst local improvement of individual tasks to regularize the algorithm trajectory. CAGrad balances the objectives automatically and still provably converges to a minimum over the average loss. It includes the regular gradient descent (GD) and the multiple gradient descent algorithm (MGDA) in the multi-objective optimization (MOO) literature as special cases. On a series of challenging multi-task supervised learning and reinforcement learning tasks, CAGrad achieves improved performance over prior state-of-the-art multi-objective gradient manipulation methods.},
  archiveprefix = {arXiv},
  keywords = {/unread,Computer Science - Artificial Intelligence,Computer Science - Machine Learning},
  file = {/Users/haohe/Zotero/storage/9LH9ZTZ7/Liu 等 - 2024 - Conflict-Averse Gradient Descent for Multi-task Learning.pdf;/Users/haohe/Zotero/storage/3HJ7ZP45/2110.html}
}

@article{liuDecomposingUrbanSpatial2026,
  title = {Decomposing Urban Spatial Rhythms: {{A}} Big-Small Data Fusion Framework for Activity Pattern Identification},
  shorttitle = {Decomposing Urban Spatial Rhythms},
  author = {Liu, Yinong and Hu, Yang and Wang, De and Cheng, Ying and Yan, Longxu and Wei, Dan and Jiao, Jian},
  year = 2026,
  month = feb,
  journal = {Cities},
  volume = {169},
  pages = {106548},
  issn = {0264-2751},
  doi = {10.1016/j.cities.2025.106548},
  urldate = {2025-12-09},
  abstract = {Cities exhibit temporal patterns shaped by circadian rhythms and social routines. However, rapid urbanization has created temporal mismatches between urban demand and available resources. Traditional urban analysis methods primarily rely on static data sources and have limitations in capturing these temporal dynamics. This study proposes a big-small data fusion framework to decompose~Urban Spatial Rhythm (USR)---the temporal pattern of population presence within spatial units---into its constituent daily activity patterns using constrained optimization. The framework combines the spatial coverage of mobile phone signaling data with the semantic richness of time-use survey data, assuming that USR can be expressed as weighted combinations of daily activity patterns that exhibit both spatial consistency and additivity. It employs Sequential Least Squares Programming to solve the decomposition problem. When applied to Shanghai, the framework identifies seven primary activity types: maintenance and sleep, purchasing commodities, leisure and entertainment, employment and education, eating and drinking, housework and care, and travel and visits. The framework reveals how these activities exhibit distinct 24- h population dynamics across different spatial units, with notable variations between weekdays and weekends. Through multi-dimensional validation and comparative analysis, the decomposition framework proves reliable, offering superior coverage of activity types and a more detailed depiction of temporal dynamics compared to other big data and static sources. The framework contributes to urban rhythm research by enabling activity identification and spatiotemporal estimation, and may provide value for dynamic urban planning, transportation coordination, and service allocation, potentially supporting evidence-based urban governance.},
  keywords = {/unread,Big-small data integration,Daily activity pattern,Rhythm decomposition,Urban dynamics,Urban spatial rhythm},
  file = {/Users/haohe/Zotero/storage/7JR7S3FD/S0264275125008510.html}
}

