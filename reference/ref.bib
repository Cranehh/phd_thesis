@article{huangInvestigatingSociospatialDifferentiation2024,
  title = {Investigating Socio-Spatial Differentiation for Metro Travelers Using Smart Card Data: {{Older}} People vs. Others},
  shorttitle = {Investigating Socio-Spatial Differentiation for Metro Travelers Using Smart Card Data},
  author = {Huang, Jie and Xiong, Meicheng and Wang, Jiaoe and Cheng, Long and Yang, Haoran},
  year = 2024,
  month = apr,
  journal = {Applied Geography},
  volume = {165},
  pages = {103230},
  issn = {0143-6228},
  doi = {10.1016/j.apgeog.2024.103230},
  urldate = {2024-05-27},
  abstract = {As population aging has been an issue worldwide, the mobility of older people have attracted the attention of scholars from urban planning, transport geography, and social science. However, few have investigated socio-spatial differentiation among mobility groups, considering their daily needs and activity spaces. To fill this research gap, we conducted a comparative analysis of socio-spatial differentiation, based on individual activity spaces. We used smart card data from Kunming, China, to identify selected individuals' residential locations and travel patterns, and evaluate their accessed activity space. We performed a disaggregated analysis of the individual activity space, and then aggregated the activity counts on each grid. This study found that the residential locations of older metro travelers are significantly different from those of other metro travelers. In addition, socio-spatial differentiation was found to exist due to different daily requirements. The results were confirmed in three LASSO models with built environment variables. These findings are useful in urban and transportation planning to improve elder-friendly services.},
  langid = {american},
  keywords = {Big data,Mobility group,Population aging,Socio-spatial differentiation,Travel behavior},
  file = {/Users/haohe/Zotero/storage/FJZY85K5/Huang 等 - 2024 - Investigating socio-spatial differentiation for me.pdf;/Users/haohe/Zotero/storage/EWWPZ9YX/S0143622824000353.html}
}

@phdthesis{HuangJiangYanJiYuZhiNengTiFangZhenDeChengShiDuoMoShiZuHeChuXingFenXi2021,
