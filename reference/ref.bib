@article{lavalCongestedUrbanNetworks2022,
  title = {Congested {{Urban Networks Tend}} to {{Be Insensitive}} to {{Signal Settings}}: {{Implications}} for {{Learning-Based Control}}},
  author = {Laval, Jorge and Zhou, Hao},
