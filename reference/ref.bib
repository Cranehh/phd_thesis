  series = {Urbanization, {{Transportation}} and {{Air Quality}} in {{Developing Countries}}},
  volume = {68},
  pages = {39--51},
  issn = {1361-9209},
  doi = {10.1016/j.trd.2018.05.008},
  urldate = {2024-07-21},
  abstract = {Weather conditions have been recognized as important factors affecting school commute mode choices. This paper aims to explore the modal shift of middle school commutes with respect to the variation in weather-related variables, with empirical emphases on the situation in Beijing, China. Data from the latest Beijing School Commute Survey (2014--2015) were adopted, and multinomial probit (MNP) and multinomial logit (MNL) models were developed. The modeling results are in favor of the MNP model because it has better statistical performance. Weather-related variables, including sky condition, wind speed, highest temperature, humidity, air quality index (AQI), and some interaction terms, were found to have a significant impact on students' commute mode choices. Based on these models, an empirical sensitivity measure was defined as the expected percentage change in the probability of choosing each mode with respect to an order of magnitude change in the influential factors. Most of the results are in line with those of previous studies, and some unique results reflect features of Beijing. For example, on days with extremely poor air quality, students are more likely to turn to public transport rather than use a car from active transportation modes. This is probably due to the special urban traffic regulations that restrict household car ownership and car travel in Beijing. These findings could have implications for promoting active transportation for students and serve as references for policymakers and planners.},
  keywords = {Empirical sensitivity,Mode choice,Multinomial probit model,School commute,Weather condition},
  file = {/Users/haohe/Zotero/storage/XMKTZ2XL/Ma 等 - 2019 - Impact of weather conditions on middle school stud.pdf;/Users/haohe/Zotero/storage/837ZGWIC/S1361920917304777.html}
}

@phdthesis{MaJunChiGuoJiLuGangQunXiTongYouHuaJiFaZhanCeLueYanJiu2024,
  type = {{博士学位论文}},
  title = {{国际陆港群系统优化及发展策略研究}},
  author = {{马骏驰}},
  year = 2024,
  month = mar,
  urldate = {2026-01-19},
  abstract = {以内陆之地，行港口之实，是谓陆港。随着我国``一带一路''倡议、``交通强国''战略、``陆港型国家物流枢纽''建设等国家级重大战略的提出，``公转铁''、``散改集''等政策的推行，我国的国际陆港建设发展迎来了良好的政策环境与发展机遇，部分区域的国际陆港发展呈现出集群化特征。但与此同时，我国国际陆港群系统方面的理论研究落后于应用实践的现象已经凸显。研究国际陆港群系统综合优化问题，有助于形成布局合理、协同共进的国际陆港群，对探索我国内陆地区发展外向型经济、融入世界贸易的新通道，构建东中西协调发展、统筹国内国际双循环的现代物流服务体系具有重要意义。 本文综合应用系统工程理论、多准则群决策方法、不确定理论、双层规划等基础理论与方法，从港产城联动、港港联动、港产联动等视角出发，通过定性分析与定量计算相结合的方式，研究了国际陆港群的系统分析、发展评价与优化、网络优化及规模与功能协同优化四个方面的问题。 (1)研究国际陆港群的系统内涵与发展演化问题。从生态学角度出发，明确了国际陆港群系统的具体内涵、系统要素及系统环境，分析了国际陆港群系统的发展演化规律及演化阶段。在此基础上，从港港联动、港产联动、港城联动发展角度研究了国际陆港群系统发展与区域经济增长间的作用机理，明确了不同视角下国际陆港群系统的优化问题，为后续研究提供了方向。 (2)研究国际陆港发展评价与陆港群优化策略问题。从港产城联动视角出发，借鉴生态学中的``压力-状态-响应''评价体系，深入分析了国际陆港群发展中的核心问题，创新提出了``需求-风险-实力-潜力''评价体系。在此基础上，构建了国际陆港发展多准则群决策评价模型，提出了以决策试验-评价实验室法与贝叶斯最好最坏法相结合的国际陆港发展评价指标权重赋值方法。以淮海经济区国际陆港群发展评价问题为算例，依托所构建的评价模型，得出陆港群内各陆港建设优先级排名，同时构建了各陆港各指标绩效-重要性矩阵，对淮海经济区国际陆港群内各陆港提出了具体的优化重点。进一步，依据实验结果，明确了提升区域跨境贸易发展等级、优化国际陆港群集装箱多式联运网络、优化国际陆港群规模与功能等陆港群发展策略，有助于国际陆港群系统实现高质量、可持续发展，同时为后续章节研究提供了现实依据。 (3)研究国际陆港群集装箱跨境多式联运网络优化问题。从港港联动视角出发，通过对跨境运输需求的确定性与不确定性进行刻画，为国际陆港群集装箱跨境多式联运网络的陆港布局及路径设计问题建立了确定性和不确定性模型。基于不确定理论，推导出不确定规划的等价实数规划。并在此基础上，结合淮海经济区-欧洲集装箱跨境多式联运网络，进行了算例研究。结合灵敏度分析，对国际陆港群集装箱跨境多式联运网络的陆港选址、运输路径选择、总成本优化、网络稳定性提升等提出了相关发展策略。 （4）研究国际陆港群规模与功能协同优化问题。从港产联动视角出发，在考虑国际陆港规划过程中地方政府和货源企业之间的动态互动关系的基础上，针对国际陆港群规模与功能协同优化问题构建了双层规划模型，其中上层面向地方政府，下层面向货源企业。结合遗传算法和精确解法，设计了一种混合启发式算法以求解上述模型。以淮海经济区国际陆港群规划问题为算例，验证了所提出模型和算法的适用性。计算结果表明，所提出的优化方法在有限的投资额度内有效提高了国际陆港群的跨境运输市场份额，并弱化了陆港群内各陆港间的竞争。进一步，结合灵敏度分析，提出了多项具体的国际陆港群规模与功能优化建议。},
  collaborator = {{王喜富}},
  langid = {chinese},
  school = {北京交通大学},
  keywords = {,/unread},
  annotation = {major: 控制科学与工程\\
CLC: F512.4},
  file = {/Users/haohe/Zotero/storage/45TUI2C9/马骏驰 - 2024 - 国际陆港群系统优化及发展策略研究.pdf}
}

@article{malayathActivityBasedTravel2013,
  title = {Activity Based Travel Demand Models as a Tool for Evaluating Sustainable Transportation Policies},
  author = {Malayath, Manoj and Verma, Ashish},
  year = 2013,
  month = feb,
  journal = {Research in Transportation Economics},
  series = {Economics of {{Sustainable Transport}} in {{India}}},
  volume = {38},
  number = {1},
  pages = {45--66},
  issn = {0739-8859},
  doi = {10.1016/j.retrec.2012.05.010},
  urldate = {2025-05-28},
  abstract = {India is in the course of an economic transition. The economic growth nurtured the life in the cities and cities have become a major livelihood destination for everyone. This migration of people contributed to the increased urbanization of Indian cities. The booming economy fostered the well-being and shaped the lifestyle of people in such a way that the dependency on private vehicle has become an unavoidable affair. Along with population growth, the increased vehicle ownership gave rise to overall spurt in travel demand. But the supply side lagged behind the demand adding to many of the transport related externalities such as accidents, congestion, pollution, inequity etc. The importance of sustainability is understood in the current urban transport scenario leading to the development and promotion of sustainable transport polices. The core agenda of these polices is to target the travel behavior of people and change the way they travel by creating a different travel environment. However, the impacts of many such policies are either unknown or complex. Hence, before adopting and implementing such policies, it is important for the decision makers to be aware of the impacts of them. The role of travel demand models comes here as they predict the future travel demand under different policy scenarios. This paper reviews the ability of travel demand models applied in India in analyzing the sustainable transport policies. The study found that the conventional model system in India, which is trip based four step aggregate methodology, is inadequate in analyzing the sustainable transport policies. A review of alternative approach, known as activity based travel demand modeling found that they are capable of handling such policies better than conventional models and are assistive to the decision makers in arriving at right mix of polices specific to the situations. Since there is no operational activity based travel demand model system developed in India, the study at the end envisaged a conceptual framework of an integrated activity based travel demand model based on the requirements identified from the review. This can potentially replace the existing travel demand models and can be used for planning applications once the modification \& validation have been done according to the existing activity-travel behavior of individuals.},
  langid = {american},
  keywords = {Sustainable transportation policies,Trip-based and activity-based travel demand modelling},
  file = {/Users/haohe/Zotero/storage/2LRLPYXL/Malayath和Verma - 2013 - Activity based travel demand models as a tool for evaluating sustainable transportation policies.pdf;/Users/haohe/Zotero/storage/6ZF6Z4B7/S0739885912000558.html}
}

