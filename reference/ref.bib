@article{yinOptimizingReleasePassenger2019,
  title = {Optimizing the Release of Passenger Flow Guidance Information in Urban Rail Transit Network via Agent-Based Simulation},
  author = {Yin, Haodong and Wu, Jianjun and Liu, Zhiyuan and Yang, Xin and Qu, Yunchao and Sun, Huijun},
  year = 2019,
