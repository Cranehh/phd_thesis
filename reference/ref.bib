@article{thorhaugeHabitdrivenLifeAccounting2020,
  title = {The Habit-Driven Life: {{Accounting}} for Inertia in Departure Time Choices for Commuting Trips},
  shorttitle = {The Habit-Driven Life},
  author = {Thorhauge, Mikkel and Swait, Joffre and Cherchi, Elisabetta},
