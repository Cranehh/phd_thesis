@article{weiDesignEvaluationDynamic2014,
  title = {Design and {{Evaluation}} of a {{Dynamic Sectorization Algorithm}} for {{Terminal Airspace}}},
  author = {Wei, Jian and Sciandra, Vince and Hwang, Inseok and Hall, William D.},
