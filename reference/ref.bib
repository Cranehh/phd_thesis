@article{nurulhabibComprehensiveUtilitybasedSystem2018,
  title = {A Comprehensive Utility-Based System of Activity-Travel Scheduling Options Modelling ({{CUSTOM}}) for Worker's Daily Activity Scheduling Processes},
  author = {Nurul Habib, Khandker},
  year = 2018,
  month = apr,
