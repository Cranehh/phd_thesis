  langid = {english},
  keywords = {queuing theory,UAVs,urban air mobility (UAM),vertiport capacity},
  annotation = {TLDR: A theoretical capacity calculation model for ground facilities such as takeoff and landing platforms, taxiways and aprons, respectively, and analyzes the service characteristics of each ground facility to obtain UAV delay curves based on a UAV Poisson flow arrival model.},
