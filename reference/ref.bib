@article{yangResearchLongitudinalActive2019,
  title = {Research on {{Longitudinal Active Collision Avoidance}} of {{Autonomous Emergency Braking Pedestrian System}} ({{AEB-P}})},
  author = {Yang, Wei and Zhang, Xiang and Lei, Qian and Cheng, Xin},
  year = 2019,
  month = jan,
  journal = {Sensors},
