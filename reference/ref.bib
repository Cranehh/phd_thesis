@article{straubingerOverviewCurrentResearch2020,
  title = {An Overview of Current Research and Developments in Urban Air Mobility -- {{Setting}} the Scene for {{UAM}} Introduction},
  author = {Straubinger, Anna and Rothfeld, Raoul and Shamiyeh, Michael and B{\"u}chter, Kai-Daniel and Kaiser, Jochen and Pl{\"o}tner, Kay Olaf},
