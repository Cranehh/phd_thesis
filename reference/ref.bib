}

@article{angelelliCongestionAvoidingHeuristic2018,
  title = {Congestion Avoiding Heuristic Path Generation for the Proactive Route Guidance},
  author = {Angelelli, E. and Morandi, V. and Speranza, M. G.},
  year = 2018,
