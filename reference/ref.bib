}

@article{chenBayesianStochasticKriging2019,
  title = {A {{Bayesian Stochastic Kriging Optimization Model Dealing}} with {{Heteroscedastic Simulation Noise}} for {{Freeway Traffic Management}}},
  author = {Chen, Xiqun (Michael) and He, Xiang and Xiong, Chenfeng and Zhu, Zheng and Zhang, Lei},
  year = 2019,
  month = mar,
  journal = {Transportation Science},
