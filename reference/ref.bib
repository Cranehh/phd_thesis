@article{xueExploringResidentialRelocation2020,
  title = {Exploring Residential Relocation Behavior for Families with Workers and Students; a Study from {{Beijing}}, {{China}}},
  author = {Xue, Fei and Yao, Enjian and Jin, Fanglei},
  year = 2020,
  journal = {Journal of Transport Geography},
