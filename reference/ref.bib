@article{huoHeteroscedasticRobustBayesian2025,
  title = {A {{Heteroscedastic Robust Bayesian Optimization Method}} for {{Solving Simulation-Based Transportation Problems}}},
  author = {Huo, Jinbiao and Gu, Ziyuan and Liu, Zhiyuan and Wang, Shuaian and Laporte, Gilbert},
  year = 2025,
