@article{zhuSurveyDeepRL2022,
  title = {A {{Survey}} of {{Deep RL}} and {{IL}} for {{Autonomous Driving Policy Learning}}},
  author = {Zhu, Zeyu and Zhao, Huijing},
  year = 2022,
  journal = {IEEE Transactions on Intelligent Transportation Systems},
