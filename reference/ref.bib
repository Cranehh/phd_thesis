  annotation = {TLDR: Using 539 adult internet users in the Minneapolis-St Paul metropolitan area, a structural equations model is applied to investigate the interactions among online purchases, in-store shopping, and product information search via internet and found that online searching frequency has positive impacts on both online and in- store shopping frequencies.},
  file = {/Users/haohe/Zotero/storage/H9YYRF2D/Cao 等 - 2012 - The interactions between e-shopping and traditional in-store shopping an application of structural.pdf}
