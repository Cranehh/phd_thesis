  keywords = {Aircraft,Atmospheric modeling,Automatic Dependent Surveillance-Broadcast,Collision Risk Model,Dynamic Airspace Planning,Path planning,Planning,Surveillance,Unmanned aerial vehicles,Unmanned Aerial Vehicles},
