@article{panStatictodynamicModelingCoupled2026,
  title = {Static-to-Dynamic Modeling of the Coupled Mobility-as-a-Service Subscriptions and Travel Choices},
  author = {Pan, Manlian and Sun, Xiaotong and Mo, Haoyu},
  year = 2026,
  month = oct,
  journal = {Transportation Research Part C: Emerging Technologies},
  volume = {191},
  pages = {105847},
  issn = {0968-090X},
  doi = {10.1016/j.trc.2026.105847},
  urldate = {2026-08-05},
  abstract = {A distinguishing feature of the emerging Mobility-as-a-Service (MaaS) is the provision of integrated mobility services through subscription plans, commonly known as MaaS bundles. While its intertemporal and multi-modal tariff structure creates a close coupling between periodic subscription decisions and daily travel choices, theoretical analyses remain limited in the interplay between periodic bundle subscriptions and daily path choices. This study addresses this gap by examining how these intertwined travel behaviors influence system evolution, stability, and overall performance under MaaS's two-part tariff structure. We first develop a hierarchical discrete choice model that incorporates travelers' heterogeneous loyalty to MaaS bundles to characterize the static equilibrium, formulated as a variational inequality problem. We then represent the dynamic evolution of subscriptions and path choices through a two-level day-to-day dynamical model that embeds both path inertia and bundle loyalty, and we derive the corresponding separate sufficient and necessary stability conditions. Both theoretical and numerical convergence analyses reveal that daily path inertia dominates the convergence of the coupled dynamics, outweighing the influence of bundle loyalty. We further introduce a bundle-pricing framework under a two-part tariff structure that links travelers' choices with system performance and supports evaluating trade-offs across policy objectives. Finally, static optimal bundle pricing, which is computationally less demanding than dynamically optimizing bundle prices, also demonstrates robust performance in dynamic scenarios.},
  keywords = {/unread,Coupled dynamics,MaaS bundle subscription,Random utility theory,Static equilibrium},
  file = {/Users/haohe/Zotero/storage/48KS47ZR/Pan 等 - 2026 - Static-to-dynamic modeling of the coupled mobility-as-a-service subscriptions and travel choices.pdf;/Users/haohe/Zotero/storage/64B6XW75/S0968090X26003359.html}
}

@article{parkerPublicTransitUse2021,
  title = {Public Transit Use in the {{United States}} in the Era of {{COVID-19}}: {{Transit}} Riders' Travel Behavior in the {{COVID-19}} Impact and Recovery Period},
  shorttitle = {Public Transit Use in the {{United States}} in the Era of {{COVID-19}}},
  author = {Parker, Madeleine E. G. and Li, Meiqing and Bouzaghrane, Mohamed Amine and Obeid, Hassan and Hayes, Drake and Frick, Karen Trapenberg and Rodr{\'i}guez, Daniel A. and Sengupta, Raja and Walker, Joan and Chatman, Daniel G.},
  year = 2021,
  month = sep,
  journal = {Transport Policy},
  volume = {111},
  pages = {53--62},
  issn = {0967-070X},
  doi = {10.1016/j.tranpol.2021.07.005},
  urldate = {2024-07-10},
  abstract = {COVID-19 has upended travel across the world, disrupting commute patterns, mode choices, and public transit systems. In the United States, changes to transit service and reductions in passenger volume due to COVID-19 are lasting longer than originally anticipated. In this paper we examine the impacts of the COVID-19 pandemic on individual travel behavior across the United States. We analyze mobility data from Janurary to December 2020 from a sample drawn from a nationwide smartphone-based panel curated by a private firm, Embee Mobile. We combine this with a survey that we administered to that sample in August 2020. Our analysis provides insight into travel patterns and the immediate impacts of the COVID-19 pandemic on transit riders. We investigate three questions. First, how do transit riders differ socio-demographically from non-riders? Second, how has the travel behavior of transit riders changed due to the pandemic in comparison to non-riders, controlling for other factors? And third, how has this travel behavior varied across different types of transit riders? The travel patterns of transit riders were more significantly disrupted by the pandemic than the travel of non-riders, as measured by the average weekly number of trips and distance traveled before and after the onset of the pandemic. This was calculated using GPS traces from panel member smartphones. Our survey of the panel revealed that of transit riders, 75\% reported taking transit less since the pandemic, likely due to a combination of being affected by transit service changes, concerns about infection risk on transit, and trip reductions due to shelter-in-place rules. Less than 10 percent of transit riders in our sample reported that they were comfortable using transit despite COVID-19 infection risk, and were not affected by transit service reductions. Transit riders were also more likely to have changed their travel behavior in other ways, including reporting an increase in walking. However, lower-income transit riders were different from higher-income riders in that they had a significantly smaller reduction in the number of trips and distance traveled, suggesting that these lower-income households had less discretion over the amount of travel they carried out during the pandemic. These results have significant implications for understanding the way welfare has been affected for transportation-disadvantaged populations during the course of the pandemic, and insight into the recovery of U.S. transit systems. The evidence from this unique dataset helps us understand the future effects of the pandemic on transit riders in the United States, either in further recovery from the pandemic with the anticipated effects of mass vaccination, or in response to additional waves of COVID-19 and other pandemics.},
  keywords = {/unread,COVID-19,Public transit,Recovery period,Transportation justice,Travel behavior},
  file = {/Users/haohe/Zotero/storage/ZU3VIIHN/Parker 等 - 2021 - Public transit use in the United States in the era.pdf}
}

