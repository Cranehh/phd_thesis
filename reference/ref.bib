@article{caiatiBundlingPricingSchemes2020,
  title = {Bundling, Pricing Schemes and Extra Features Preferences for Mobility as a Service: {{Sequential}} Portfolio Choice Experiment},
  author = {Caiati, Valeria and Rasouli, Soora and Timmermans, Harry},
  year = 2020,
  journal = {Transportation Research Part A: Policy and Practice},
