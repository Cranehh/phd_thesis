@phdthesis{WangYiJiYuYangQunXiaoYingDeJiaoChaKouHongDengJieDuanXingRenWeiGuiXingWeiYanJiu2023,
  type = {{硕士}},
  title = {{基于羊群效应的交叉口红灯阶段行人违规行为研究}},
  author = {{王一}},
  year = 2023,
  doi = {10.26976/d.cnki.gchau.2022.001225},
  urldate = {2024-05-06},
  abstract = {近年来,我国渐渐加强了对道路安全的管控,虽然道路安全状况已经有所改善,但是城市道路交通中仍然存在着一些风险问题;步行是城市内交通出行方式中最基本的组成部分,在交通系统中起着至关重要的作用,过街是步行过程中不可避免的重要环节。在交叉口,存在行人在红灯的最后几秒闯红灯的不良现象,此时一旦发生事故,行人作为道路使用者中的弱势群体,极易受到严重的伤害。伴随着``以人为本''的可持续发展理念被广泛提倡,行人交通安全成为了学者们研究的热点内容,尤其是行人交通安全中的行人过街安全。目前国内外学者对行人过街的特性、行人过街时的违规行为等内容已经进行了深入的研究,已有研究表明信号灯交叉口违规过街的行人群体存在着明显的从众心理,行人的闯红灯行为会受到社会信息如群体内其他行人行为的影响,但鲜少有人对违规群体中先后做出违规行为的行人的差异化特征进行深入研究分析。基于此,本文考虑到违规过街行为中的羊群效应现象,将交叉口红灯阶段做出违规行为的群体分为领头羊和跟随者,建立了SIR模型来探究违规行为的传播机制,通过SPSS软件建立Logistic模型来研究红灯阶段行人违规行为的影响因素,探究先后做出违规行为的行人的特征。以西安市为例,将无人机视频拍摄和观察方法相结合来获取本文研究所需数据,基于羊群效应对交叉口红灯阶段行人的违规行为从时间和空间的角度进行分析。得出结论,在不同的时间和空间,交叉口红灯阶段行人违规行为的传播情况也不相同,在早高峰传播的较快;人行横道较短且绿化带距离人行横道较近的交叉口的违规行为的传播率和最终违章率均较高;另外分析Logistic模型得到性别、是否看车流、时间以及交叉口等因素对行人的领头羊身份有显著性影响,也即男性、频繁看车流、等待时没有被分心且在绿化带处等待的行人容易成为周期内的领头羊,而跟随者更多是女性和被分心的行人。人行横道长度、绿化带的位置等周围的道路交通环境也与领头羊的出现有关。早高峰领头羊出现的概率要大于晚高峰,午高峰与晚高峰之间领头羊出现概率不存在较明显差异性。最后,根据研究结果有针对性地提出了一些建议来改善交叉口行人违规现象,提高信号灯交叉口的安全水平。},
  langid = {chinese},
  school = {长安大学},
  keywords = {,Logistic,SIR},
  file = {/Users/haohe/Zotero/storage/7J3SDG2K/王 - 2023 - 基于羊群效应的交叉口红灯阶段行人违规行为研究.pdf}
}

@article{WangYueDiTanDaoXiangDeDuoMoShiJiaoTongChuXingFuWuDingJieCeLue2023,
  title = {{低碳导向的多模式交通出行服务定价策略}},
  author = {{王月} and {姚恩建} and {郝赫}},
  year = 2023,
  journal = {清华大学学报（自然科学版）},
  volume = {63},
  number = {11},
  pages = {1741--1749},
  issn = {1000-0054},
  doi = {10.16511/j.cnki.qhdxxb.2023.26.024},
  urldate = {2025-05-28},
  abstract = {优化出行结构、提升出行效率、降低交通碳排放是交通绿色低碳发展的重要路径。该文提出一种低碳导向的多模式交通出行服务定价调节策略，从出行服务商、出行者和环境角度出发，以服务商收益最大化，网络出行时间和交通碳排放量最小化为目标，构建多目标优化模型，在考虑出行者出行方式和路径联合选择行为的情况下对网络流量均衡分配，实现多方式协同出行和碳排放管理精细化。算例分析结果表明：服务商通过定价调节能优化网络出行结构、缓解小汽车路段拥堵状况、提高公共交通的分担率，同时实现自身盈利和交通碳排放量下降的目标。不同的优化结果表明：服务商不能仅追求自身收益最大化，还需要综合考虑出行者出行成本和出行方式对交通环境的影响，承担交通系统的协调与减排责任。该文明确了出行服务商在交通绿色低碳发展中的盈利空间和应承担的责任，为服务定价策略提供参考依据。},
