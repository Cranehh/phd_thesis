  author = {Porta, Sergio and Latora, Vito and Wang, Fahui and Rueda, Salvador and Strano, Emanuele and Scellato, Salvatore and Cardillo, Alessio and Belli, Eugenio and C{\`a}rdenas, Francisco and Cormenzana, Berta and Latora, Laura},
