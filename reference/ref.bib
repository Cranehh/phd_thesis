@article{wangSocioeconomicDisparitiesActivitytravel2022,
  title = {Socio-Economic Disparities in Activity-Travel Behavior Adaptation during the {{COVID-19}} Pandemic in {{North Carolina}}},
  author = {Wang, Jueyu and Kaza, Nikhil and McDonald, Noreen C. and Khanal, Kshitiz},
  year = 2022,
