  doi = {10.16097/j.cnki.1009-6744.2021.05.012},
  urldate = {2025-05-26},
  abstract = {动态交通分配(Dynamic Traffic Assignment,DTA)理论是智能交通系统中最重要的关键技术基础之一,也是当前交通科学中最活跃的研究领域之一,其模型可以广泛应用于离线的交通规划及政策评估和在线的智能交通系统应用。本文首先回顾了DTA理论50年来的发展历程,总结了不同发展阶段形成的重要理论和方法。其次介绍了DTA问题的两个基本构成:出行选择准则和交通流传播模型,指出这两个基本组成部分通过走行时间函数(或阻抗函数)来关联,并总结了DTA问题中主要的出行选择准则、主要的交通流传播模型、重点关注的交通行为、走行时间函数。依据出行者的出行选择内容、交通状况掌握、出行需求弹性、出行决策时间跨度以及用户类型等对动态交通分配问题进行分类,并详细比较分析不同类型动态交通分配问题之间的差异。进一步,介绍了DTA问题主要的解析模型,依据时间是否连续和使用的决策变量分别对DTA模型进行分类,并总结了不同类型DTA模型的主要优缺点。介绍了不同出行选择准则下DTA问题的主要求解方法,并评述求解方法的收敛性、效率等。此外,还概述了DTA模型在交通规划、交通政策评估、交通控制与管理等方面的应用。最后,对DTA理论的进一步发展进行展望,指出DTA理论和方法可以在5方面取得突破:动态网络加载模型的高效计算方法和性态良好的动态阻抗函数,大规模交通网络上DTA问题的有效求解算法,超级网络上基于活动链的DTA模型,DTA模型在交通管理与控制中的应用,未来智能网联环境下DTA模型及其应用。},
  langid = {chinese},
  annotation = {foundation: 国家自然科学基金(71871077,71925001)\textasciitilde\textasciitilde ；\\
download: 2034\\
album: 工程科技II辑\\
CLC: U491\\
dbcode: CJFQ\\
dbname: CJFDLAST2021\\
filename: YSXT202105013},
  file = {/Users/haohe/Zotero/storage/IYT5AMLE/龙建成和郭嘉琪 - 2021 - 动态交通分配问题研究回顾与展望.pdf}
}

@article{longTurningRestrictionDesign2010,
  title = {A Turning Restriction Design Problem in Urban Road Networks},
  author = {Long, Jiancheng and Gao, Ziyou and Zhang, Haozhi and Szeto, W. Y.},
  year = 2010,
  month = nov,
  journal = {European Journal of Operational Research},
  volume = {206},
  number = {3},
  pages = {569--578},
  issn = {0377-2217},
  doi = {10.1016/j.ejor.2010.03.013},
  urldate = {2023-06-07},
  abstract = {Turning restriction is one of the commonest traffic management techniques and an effective low cost traffic improvement strategy in urban road networks. However, the literature has not paid much attention to the turning restriction design problem (TRDP), which aims to determine a set of intersections where turning restrictions should be implemented. In this paper, a bi-level programming model is proposed to formulate the TRDP. The upper level problem is to minimize the total travel cost from the viewpoint of traffic managers, and the lower level problem is to depict travelers' route choice behavior based on stochastic user equilibrium (SUE) theory. We propose a branch and bound method (BBM), based on the sensitivity analysis algorithm (SAA), to find the optimal turning restriction strategy. A branch strategy and a bound strategy are applied to accelerate the solution process of the TRDP. The computational experiments give promising results, showing that the optimal turning restriction strategy can obviously reduce system congestion and are robust to the variations of both the dispersion parameter of the SUE problem and the level of demand.},
  langid = {english},
  keywords = {Bi-level programming,Branch and bound method,Sensitivity analysis,Stochastic user equilibrium,Turning restriction design problem},
  file = {/Users/haohe/Zotero/storage/RIWXB6MZ/long2010.pdf.pdf}
}

@article{loPassengerRouteGuidance2005,
  title = {Passenger Route Guidance System for Multi-Modal Transit Networks},
