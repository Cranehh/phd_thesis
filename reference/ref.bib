  title = {Real-{{Time Holding Control}} for {{Transfer Synchronization}} via {{Robust Multiagent Reinforcement Learning}}},
  author = {Yu, Xinlian and Khani, Alireza and Chen, Jingxu and Xu, Hongli and Mao, Haijun},
  year = 2022,
