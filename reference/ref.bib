  urldate = {2025-10-08},
  abstract = {The environment of low-altitude urban airspace is complex and variable due to numerous obstacles, non-cooperative aircraft, and birds. Unmanned Aerial Vehicles (UAVs) leveraging environmental information to achieve three-dimension collision-free trajectory planning is the prerequisite to ensure airspace security. However, the timely information of surrounding situation is difficult to acquire by UAVs, which further brings security risks. As a mature technology leveraged in traditional civil aviation, the Automatic Dependent Surveillance-Broadcast (ADS-B) realizes continuous surveillance of the information of aircraft. Consequently, we leverage ADS-B for surveillance and information broadcasting, and divide the aerial airspace into multiple sub-airspaces to improve flight safety in UAV trajectory planning. In detail, we propose the secure Sub-airSpaces Planning (SSP) algorithm and Particle Swarm Optimization Rapidly-exploring Random Trees (PSO-RRT) algorithm for the UAV trajectory planning in law-altitude airspace. The performance of the proposed algorithm is verified by simulations and the results show that SSP reduces both the maximum number of UAVs in the sub-airspace and the length of the trajectory, and PSO-RRT reduces the cost of UAV trajectory in the sub-airspace.},
  keywords = {/unread,ADS-B,Collision avoidance,Low-altitude urban airspace,Sliding window,Three-dimension trajectory planning of UAV},
  file = {/Users/haohe/Zotero/storage/G7EJW5WX/Dong 等 - 2025 - Three-dimension collision-free trajectory planning of UAVs based on ADS-B information in low-altitud.pdf;/Users/haohe/Zotero/storage/7Q2Y8HXF/S1000936124003029.html}
}

@article{dozzaUsingNaturalisticData2016,
  title = {Using Naturalistic Data to Assess E-Cyclist Behavior},
  author = {Dozza, Marco and Bianchi Piccinini, Giulio Francesco and Werneke, Julia},
  year = 2016,
  month = aug,
  journal = {Transportation Research Part F: Traffic Psychology and Behaviour},
  series = {Bicycling and Bicycle Safety},
  volume = {41},
  pages = {217--226},
