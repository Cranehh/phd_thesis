}

@article{luWorldwideScalingWaste2024,
  title = {Worldwide Scaling of Waste Generation in Urban Systems},
  author = {Lu, Mingzhen and Zhou, Chuanbin and Wang, Chenghao and Jackson, Robert B. and Kempes, Christopher P.},
  year = 2024,
  month = feb,
  journal = {Nature Cities},
  volume = {1},
  number = {2},
  pages = {126--135},
  publisher = {Nature Publishing Group},
  issn = {2731-9997},
  doi = {10.1038/s44284-023-00021-5},
  urldate = {2024-03-30},
  abstract = {The production of waste as a consequence of human activities is one of the most fundamental challenges facing our society and global ecological systems. Waste generation is rapidly increasing, with corresponding shifts in the structure of our societies, where almost all nations are moving from rural agrarian societies to urban and technological ones. However, the connections between these societal shifts and waste generation have not yet been described. In this study we applied scaling theory to establish a new understanding of waste in urban systems and identified universal scaling laws of waste generation across diverse urban systems worldwide for three forms of waste: wastewater, municipal solid waste, and greenhouse gases. We found that wastewater generation scales superlinearly, municipal solid waste scales linearly, and greenhouse gas emissions scale sublinearly with city size. In specific cases, production can be understood in terms of city size coupled with financial and natural resources. For example, wastewater generation can be understood in terms of the increased economic activity of larger cities, and the deviations from the scaling relationship, indicating relative efficiency, depend on gross domestic product per person and local rainfall. The temporal evolution of these scaling relationships reveals a loss of economies of scale and a general increase in waste production, where sublinear scaling relationships become linear. Our findings suggest general mechanisms controlling waste generation across diverse cities and global urban systems. Our approach offers a systematic framework to uncover these underlying mechanisms that might be key to reducing waste and pursuing a more sustainable future.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {Environmental sciences,Sustainability},
  file = {/Users/haohe/Zotero/storage/5HMSIZBY/44284_2023_21_MOESM1_ESM.pdf;/Users/haohe/Zotero/storage/CGJKK9J8/Lu 等 - 2024 - Worldwide scaling of waste generation in urban sys.pdf}
}

@phdthesis{LuYangZhiNengQiCheGaoSuGongLuChangJingHuanDaoYuChaoCheXingWeiKongZhiCeLueYanJiu2023,
  type = {{硕士}},
  title = {{智能汽车高速公路场景换道与超车行为控制策略研究}},
  author = {{吕洋}},
  year = 2023,
  doi = {10.26976/d.cnki.gchau.2023.000604},
  urldate = {2024-02-15},
  abstract = {智能汽车技术能够显著提高道路通行效率以及行车安全性,是汽车领域的重要研究内容。本文以高速公路作为研究场景,为解决智能汽车的行为控制策略对安全性影响因素考虑不充分等问题,对智能汽车的决策模型、轨迹规划与跟踪控制算法进行研究,旨在提高智能汽车在超车以及换道过程中的行驶安全性与舒适性。对智能汽车超车以及换道的行为特性进行分析,建立了考虑行驶车速、驾驶风格等因素的最小安全距离模型,确立了考虑最小安全距离模型、最小安全跟车距离以及碰撞时间(TTC)的行为决策判断规则,在此基础上完成基于有限状态机的换道行为决策模型的搭建,实现了智能汽车的换道行为决策控制。通过仿真对比四种避障规划算法,选择人工势场法作为超车轨迹的规划算法,为使该算法适用于高速公路场景,探讨了人工势场法的改进方法,确定了人工势场法的斥力场范围随相对车速变化的函数关系,经仿真验证,改进后的算法所规划的轨迹更加平缓。通过仿真对比四种曲线插值算法,选择五次多项式曲线作为换道轨迹的规划算法,根据以换道时间和侧向加速度为评价指标的目标函数,对基于五次多项式曲线的换道轨迹进行优化,得到了换道时间为3.51s的最优换道轨迹。在三自由度车辆动力学模型的基础上,建立了基于模型预测控制的轨迹跟踪控制器,通过将智能汽车的轨迹跟踪问题转化成二次规划问题,得到了最优的控制结果,通过Carsim与Simulink联合仿真试验,该控制器能够对参考轨迹进行较好的跟踪。基于Prescan、Carsim以及Simulink完成虚拟仿真场景以及联合仿真平台的搭建,并对智能汽车的换道行为决策模型、轨迹规划以及跟踪控制算法进行仿真分析研究,结果表明:智能汽车的换道行为决策模型在2.92s时发出换道指令,反应迅速且准确,说明决策模型能够根据交通环境发出换道请求或指令,智能汽车的轨迹规划算法可以为智能汽车的超车或换道行为规划出一条光滑且安全的轨迹,轨迹跟踪控制器在进行轨迹跟踪时,智能汽车的最大质心侧偏角低于1{$^\circ$},跟踪误差小于0.2m,满足汽车高速行驶时的稳定性要求,表明本文的决策模型、规划与控制算法能够使智能汽车安全的进行超车以及换道行为。},
  langid = {chinese},
  school = {长安大学},
  file = {/Users/haohe/Zotero/storage/4APTW49U/吕 - 2023 - 智能汽车高速公路场景换道与超车行为控制策略研究.pdf}
}

@article{lyuHowDoesHighspeed2024,
  title = {How Does High-Speed Rail Affect Intercity Elderly Migration? {{Evidence}} from {{China}}},
  shorttitle = {How Does High-Speed Rail Affect Intercity Elderly Migration?},
  author = {Lyu, Guowei and Ma, Wangyuqing and Wang, Jiaoe and Jiao, Jingjuan},
  year = 2024,
  month = dec,
  journal = {Research in Transportation Business \& Management},
  volume = {57},
  pages = {101200},
  issn = {2210-5395},
  doi = {10.1016/j.rtbm.2024.101200},
  urldate = {2025-11-06},
  abstract = {The rapid aging of the population poses significant challenges for social structures and economic development, with migration emerging as a key strategy for elderly individuals to enhance their social networks, quality of life, and overall well-being. This study delves into the role of high-speed rail (HSR) in facilitating intercity migration among the elderly in China, a country experiencing a pronounced demographic shift with a burgeoning aging population. By employing a Poisson regression model on unbalanced panel data from 2008 to 2017, this paper assesses the aggregate and heterogeneous effects of HSR on elderly migration, considering various migration purposes and the mediating effects of younger generation migration. The study uncovers that elderly migration is predominantly towards economically vibrant cities, with HSR significantly influencing migration patterns by improving accessibility and connectivity. The analysis reveals that the elderly migration along with their family is more influenced by accessibility improvements, while the elderly migration for work is more responsive to enhanced connectivity provided by HSR. Furthermore, the migration of younger generations moderates the positive impact of HSR on elderly migration, particularly for family and work-related migration, but not for healthcare-related migration. The insights from this study emphasize the importance of policies that encourage inter-generational migration, allowing younger and elderly family members to move together, which can help maintain family unity and reduce the social and economic pressures on cities that receive migrants. Moreover, the study advises cautious development of HSR in less prosperous areas to avoid exacerbating population loss and regional decline.},
  langid = {american},
  keywords = {Elderly migration,High-speed rail,Poisson regression,Push-pull effect,Spatial pattern},
  file = {/Users/haohe/Zotero/storage/NDFFTPLW/Lyu 等 - 2024 - How does high-speed rail affect intercity elderly migration Evidence from China.pdf;/Users/haohe/Zotero/storage/8G8SPMS6/S2210539524001020.html}
}

