    <draw:frame draw:style-name="gr37" draw:text-style-name="P1" draw:layer="layout" svg:width="14.4cm" svg:height="1.081cm" svg:x="8.93cm" svg:y="7.949cm">
     <draw:text-box>
      <text:list text:style-name="L2">
       <text:list-item>
        <text:p text:style-name="P16"><text:span text:style-name="T11">Two scenarios with and without MaaS are required to respond</text:span></text:p>
